#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""
agy-task-runner: Autonomous & Interactive Task Runner for Antigravity (AGY) on Fibonacci.
Runs agy inside a persistent tmux session in an ephemeral git worktree,
records state in SQLite (WAL), runs evidence gates, and opens PRs.
"""

import argparse
import datetime
import os
import re
import shlex
import subprocess
import time
import uuid

from agy_dispatch_common import (
	LOGS_BASE,
	TMUX_BIN,
	TMP_BASE,
	WORKTREES_BASE,
	ensure_private_dirs,
	get_db_conn,
	init_db,
	resolve_repo_path,
	utc_now_iso,
	validate_branch_name,
	validate_safe_id,
)

AGY_BIN = os.environ.get("AGY_BIN", os.path.expanduser("~/.local/bin/agy"))
GH_BIN = os.environ.get("GH_BIN", "/home/linuxbrew/.linuxbrew/bin/gh")

# Completion poll cadence, and how long the worktree must be quiet after submit_report
# before the runner treats the report as final and runs the handoff.
TASK_POLL_SECONDS = 5
REPORT_QUIET_SECONDS = 30


def record_task_start(args, task_id: str, repo_name: str, branch_name: str, worktree_dir: str, tmux_session: str) -> None:
	"""Insert or update initial running task record in SQLite."""
	mode = "interactive" if args.interactive else "autonomous"
	with get_db_conn() as conn:
		conn.execute(
			"""
			INSERT INTO tasks (
				task_id, run_id, worker_name, repo, base_branch, branch,
				worktree_dir, tmux_session, prompt, mode, status, started_at
			)
			VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'running', ?)
			ON CONFLICT(task_id) DO UPDATE SET
				status = 'running',
				started_at = excluded.started_at,
				branch = excluded.branch,
				tmux_session = excluded.tmux_session,
				worktree_dir = excluded.worktree_dir;
			""",
			(
				task_id, args.run_id or None, args.worker_name or task_id,
				repo_name, args.base_branch, branch_name, worktree_dir,
				tmux_session, args.prompt, mode, utc_now_iso(),
			),
		)


def record_task_finish(
	task_id: str,
	status: str,
	branch: str = None,
	pr_url: str = None,
	receipt: str = None,
	error: str = None,
	duration: float = 0.0,
) -> None:
	"""Update task row upon completion or failure."""
	with get_db_conn() as conn:
		conn.execute(
			"""
			UPDATE tasks
			SET status = ?,
				branch = COALESCE(?, branch),
				pr_url = COALESCE(?, pr_url),
				evidence_receipt = COALESCE(?, evidence_receipt),
				error_log = COALESCE(?, error_log),
				completed_at = ?,
				duration_seconds = ?
			WHERE task_id = ?;
			""",
			(status, branch, pr_url, receipt, error, utc_now_iso(), round(duration, 2), task_id),
		)


def build_worker_prompt(args, task_id: str) -> str:
	"""Append coordination protocol instructions to the user prompt."""
	worker_id = args.worker_name or task_id
	run_note = f" (run_id: `{args.run_id}`)" if args.run_id else ""
	return (
		f"{args.prompt}\n\n"
		f"---\n"
		f"Worker Metadata: task_id=`{task_id}`, worker_name=`{worker_id}`{run_note}.\n"
		f"If you have `fibonacci-dispatch` MCP tools available:\n"
		f"- Call `read_messages(agent_name='{worker_id}')` if you expect peer/coordinator updates.\n"
		f"- Call `submit_report(task_id='{task_id}', summary='...', report_md='...')` as soon as your work is complete — the runner ships your branch and opens the PR automatically once the report lands.\n"
		f"- After submitting, stay open and idle so the user can inspect your work or send follow-ups. NEVER exit or send /exit on your own; only end the session when the user explicitly tells you to (directly or via the dispatcher).\n"
		f"- For follow-up work requested after your report, commit and push to your own branch `{task_id}` yourself; the PR updates automatically."
	)


def launch_tmux_agy(task_id: str, tmux_session: str, worktree_dir: str, prompt_file: str, interactive: bool, log_file: str, model: str = "") -> tuple[str, str]:
	"""Start agy -i inside a detached tmux session with zero keybinding friction."""
	exit_file = os.path.join(TMP_BASE, f"exit-{task_id}")
	wait_channel = f"agy-done-{task_id}"
	if os.path.exists(exit_file):
		os.remove(exit_file)

	perm_flag = "" if interactive else "--dangerously-skip-permissions "
	model_flag = f"--model {shlex.quote(model)} " if model else ""
	# Read prompt inside bash without exposing it in process args; signal tmux wait-for on exit
	inner_cmd = (
		f"cd {shlex.quote(worktree_dir)} && "
		f"{shlex.quote(AGY_BIN)} -i \"$(cat {shlex.quote(prompt_file)})\" "
		f"{model_flag}{perm_flag}--effort high; "
		f"rc=$?; echo $rc > {shlex.quote(exit_file)}; "
		f"{shlex.quote(TMUX_BIN)} wait-for -S {shlex.quote(wait_channel)} 2>/dev/null || true"
	)

	tmux_cmd = [
		TMUX_BIN, "new-session", "-d",
		"-s", tmux_session,
		"-c", worktree_dir,
		"bash", "-c", inner_cmd,
	]

	systemd_cmd = ["systemd-run", "--user", "--scope", f"--unit=agy-{task_id}", "--quiet"] + tmux_cmd
	res = subprocess.run(systemd_cmd, capture_output=True, text=True)
	if res.returncode != 0:
		subprocess.run(tmux_cmd, check=True)

	target = tmux_session
	for opt, val in [("status", "off"), ("prefix", "None"), ("prefix2", "None"), ("mouse", "on")]:
		subprocess.run([TMUX_BIN, "set-option", "-t", target, opt, val], capture_output=True)

	# Pass wheel events to TUI apps that request mouse; otherwise scroll pane history
	# (agy renders inline, so pane history IS the chat transcript). Server-global: fine,
	# this tmux server hosts only agy task sessions.
	wheel_up = 'if-shell -F -t= "#{mouse_any_flag}" "send-keys -M" "if -F -t= \\"#{pane_in_mode}\\" \\"send-keys -X\\" \\"copy-mode -e\\""'
	wheel_down = 'if-shell -F -t= "#{mouse_any_flag}" "send-keys -M" "if -F -t= \\"#{pane_in_mode}\\" \\"send-keys -X\\" \\"send-keys -M\\""'
	for args in (["bind-key", "-n", "WheelUpPane"] + shlex.split(wheel_up), ["bind-key", "-n", "WheelDownPane"] + shlex.split(wheel_down)):
		subprocess.run([TMUX_BIN] + args, capture_output=True)

	subprocess.run(
		[TMUX_BIN, "pipe-pane", "-t", target, "-o", f"cat >> {shlex.quote(log_file)}"],
		capture_output=True,
	)
	return exit_file, wait_channel


def tmux_session_alive(tmux_session: str) -> bool:
	"""Check whether the task's tmux session is still running."""
	try:
		res = subprocess.run([TMUX_BIN, "has-session", "-t", tmux_session], capture_output=True)
	except OSError:
		return False
	return res.returncode == 0


def report_submitted(task_id: str) -> bool:
	"""Check whether the worker has submitted its final report via submit_report."""
	with get_db_conn() as conn:
		row = conn.execute(
			"SELECT 1 FROM tasks WHERE task_id = ? AND (report_md IS NOT NULL OR summary IS NOT NULL) LIMIT 1;",
			(task_id,),
		).fetchone()
	return row is not None


def worktree_signature(worktree_dir: str) -> str:
	"""Snapshot the worktree's git status so we can tell whether the worker is still writing."""
	try:
		res = subprocess.run(["git", "status", "--porcelain"], cwd=worktree_dir, capture_output=True, text=True)
	except OSError:
		return ""
	return res.stdout.strip()


def wait_for_task_completion(tmux_session: str, exit_file: str, task_id: str, worktree_dir: str, timeout: int) -> tuple[str, int]:
	"""Wait until the worker submits its report, exits, or the timeout expires.

	Returns (mode, exit_code): 'report' means the report landed, the worktree has been quiet
	for REPORT_QUIET_SECONDS, and the worker stays live (the user ends it, not the runner);
	'exit' means the agy session ended (exit_code read from the exit file); 'timeout' means
	the session was killed at --timeout.
	"""
	deadline = (time.monotonic() + timeout) if timeout > 0 else None
	quiet_sig: str | None = None
	quiet_since: float | None = None
	while True:
		if os.path.exists(exit_file):
			try:
				with open(exit_file, "r", encoding="utf-8") as f:
					raw = f.read().strip()
				return "exit", (int(raw) if raw else 0)
			except Exception:
				return "exit", 0
		if not tmux_session_alive(tmux_session):
			return "exit", 0  # session died without writing the exit file
		if deadline is not None and time.monotonic() >= deadline:
			subprocess.run([TMUX_BIN, "kill-session", "-t", tmux_session], capture_output=True)
			return "timeout", 0
		if report_submitted(task_id):
			# Report landed: only hand off once the worktree stops changing (worker done writing).
			sig = worktree_signature(worktree_dir)
			if sig == quiet_sig and quiet_since is not None and time.monotonic() - quiet_since >= REPORT_QUIET_SECONDS:
				return "report", 0
			if sig != quiet_sig:
				quiet_sig = sig
				quiet_since = time.monotonic()
		else:
			quiet_sig = None
			quiet_since = None
		time.sleep(TASK_POLL_SECONDS)


def cleanup_after_worker_exit(repo_path: str, worktree_dir: str, branch_name: str, task_id: str, tmux_session: str, exit_file: str, log_fh) -> None:
	"""After the report handoff, wait (unbounded) for the user-initiated worker exit, then clean up.

	The worker is left live and inspectable until the user ends it (directly, or via stop);
	only then is the worktree removed. The local branch is deleted only when the recorded
	status says the task produced nothing worth keeping.
	"""
	log_fh.write("[*] Handoff complete; worker left live for user inspection — deferring cleanup until its session ends.\n")
	log_fh.flush()
	while tmux_session_alive(tmux_session):
		time.sleep(15)
	if os.path.exists(exit_file):
		os.remove(exit_file)
	status_sig = worktree_signature(worktree_dir)
	if status_sig:
		log_fh.write(f"[!] Uncommitted changes at worker exit; leaving worktree in place for manual review:\n{status_sig}\n")
		return
	delete_branch = False
	with get_db_conn() as conn:
		row = conn.execute("SELECT status FROM tasks WHERE task_id = ?;", (task_id,)).fetchone()
	if row and row["status"] in ("no_changes", "failed", "timeout"):
		delete_branch = True
	log_fh.write("[*] Worker session ended (user-initiated); removing worktree.\n")
	cleanup_worktree(repo_path, worktree_dir, branch_name, delete_branch=delete_branch)


def detect_gate(worktree_dir: str, explicit_gate: str) -> list[str]:
	"""Parse explicit gate command or auto-detect Makefile test/validate target safely."""
	if explicit_gate:
		return shlex.split(explicit_gate)
	makefile = os.path.join(worktree_dir, "Makefile")
	if os.path.exists(makefile):
		with open(makefile, "r", encoding="utf-8") as mf:
			content = mf.read()
			if "\ntest:" in content:
				return ["make", "test"]
			if "\nvalidate:" in content:
				return ["make", "validate"]
	return []


def cleanup_worktree(repo_path: str, worktree_dir: str, branch_name: str, delete_branch: bool) -> None:
	"""Remove ephemeral worktree and optionally delete unused local branch."""
	subprocess.run(["git", "worktree", "remove", "--force", worktree_dir], cwd=repo_path, capture_output=True)
	subprocess.run(["git", "worktree", "prune"], cwd=repo_path, capture_output=True)
	if delete_branch:
		subprocess.run(["git", "branch", "-D", branch_name], cwd=repo_path, capture_output=True)


def main() -> None:
	parser = argparse.ArgumentParser(
		description="Task runner for Antigravity (AGY) inside persistent tmux sessions on Fibonacci",
		formatter_class=argparse.ArgumentDefaultsHelpFormatter,
	)
	parser.add_argument("repo", help="Name of repo in ~/repos/")
	parser.add_argument("prompt", help="Task instruction prompt for AGY")
	parser.add_argument("--base-branch", default="main", help="Git base branch to branch from")
	parser.add_argument("--gate", default="", help="Validation command to run before committing (e.g. 'make test')")
	parser.add_argument("--no-push", action="store_true", help="Do not push git branch to remote")
	parser.add_argument("--no-pr", action="store_true", help="Do not create a pull request")
	parser.add_argument("--pr-draft", action="store_true", help="Create pull request as draft")
	parser.add_argument("--interactive", action="store_true", help="Keep tool permission prompts enabled instead of auto-approving")
	parser.add_argument("--timeout", type=int, default=3600, help="Maximum runtime in seconds (0 for unlimited)")
	parser.add_argument("--task-id", default="", help="Custom task ID (default: auto-generated)")
	parser.add_argument("--run-id", default="", help="Coordinator run ID grouping related workers")
	parser.add_argument("--worker-name", default="", help="Logical worker name for peer messaging")
	parser.add_argument("--model", default="", help="Model for the agy session (e.g. gemini-4-neon-high); empty = agy default")

	args = parser.parse_args()

	init_db()
	ensure_private_dirs()

	repo_path = resolve_repo_path(args.repo)
	repo_name = os.path.basename(repo_path)
	validate_branch_name(args.base_branch)

	ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d-%H%M%S")
	task_id = validate_safe_id(args.task_id, "task_id") if args.task_id else f"task-{ts}-{uuid.uuid4().hex[:6]}"
	if args.worker_name:
		validate_safe_id(args.worker_name, "worker_name")
	if args.run_id:
		validate_safe_id(args.run_id, "run_id")

	branch_name = f"agent/{task_id}"
	worktree_dir = os.path.join(WORKTREES_BASE, task_id)
	tmux_session = f"agy-{task_id}"

	log_file = os.path.join(LOGS_BASE, f"{task_id}.log")
	prompt_file = os.path.join(TMP_BASE, f"prompt-{task_id}.txt")
	exit_file = ""

	start_time = time.time()
	record_task_start(args, task_id, repo_name, branch_name, worktree_dir, tmux_session)

	print(f"[+] Task ID:      {task_id}")
	print(f"[+] Repository:   {repo_name} ({repo_path})")
	print(f"[+] Worktree:     {worktree_dir}")
	print(f"[+] tmux Session: {tmux_session}")
	print(f"[+] Log File:     {log_file}")

	delete_branch = False
	worker_left_live = False
	with open(log_file, "w", encoding="utf-8") as log_fh:
		log_fh.write(f"=== Task {task_id} Started at {utc_now_iso()} ===\n")
		log_fh.write(f"Repo: {repo_name}\nPrompt: {args.prompt}\n\n")
		log_fh.flush()

		try:
			subprocess.run(["git", "fetch", "origin", args.base_branch], cwd=repo_path, stdout=log_fh, stderr=log_fh, check=True)
			subprocess.run(["git", "worktree", "add", "-b", branch_name, worktree_dir, f"origin/{args.base_branch}"], cwd=repo_path, stdout=log_fh, stderr=log_fh, check=True)

			with open(prompt_file, "w", encoding="utf-8") as pf:
				pf.write(build_worker_prompt(args, task_id))

			log_fh.write(f"[*] Launching agy in tmux session {tmux_session}...\n")
			log_fh.flush()

			exit_file, _ = launch_tmux_agy(task_id, tmux_session, worktree_dir, prompt_file, args.interactive, log_file, model=args.model)
			mode, exit_code = wait_for_task_completion(tmux_session, exit_file, task_id, worktree_dir, args.timeout)
			worker_left_live = mode == "report" and tmux_session_alive(tmux_session)
			if mode == "timeout":
				duration = time.time() - start_time
				delete_branch = True
				err = f"Task timed out after {args.timeout}s"
				log_fh.write(f"[!] {err}\n")
				record_task_finish(task_id, "timeout", branch=branch_name, error=err, duration=duration)
				return
			if mode == "report":
				log_fh.write("[*] Worker submitted its report and is still live — running gate/push/PR handoff now.\n")
			else:
				log_fh.write(f"\n[*] agy exited with code {exit_code}\n")

			status_proc = subprocess.run(["git", "status", "--porcelain"], cwd=worktree_dir, capture_output=True, text=True)
			changes = status_proc.stdout.strip()
			if not changes:
				# Worker may have committed its own work (clean status but commits on the branch)
				ahead_proc = subprocess.run(["git", "rev-list", "--count", f"origin/{args.base_branch}..HEAD"], cwd=worktree_dir, capture_output=True, text=True)
				if ahead_proc.stdout.strip().lstrip("0"):
					log_fh.write("[*] Worktree clean but worker left commits on the branch. Treating as changes.\n")
					changes = "committed-by-worker"

			if not changes:
				duration = time.time() - start_time
				delete_branch = True
				if exit_code != 0:
					err_msg = f"agy exited with non-zero code {exit_code} and no changes"
					log_fh.write(f"[!] {err_msg}\n")
					record_task_finish(task_id, "failed", branch=branch_name, error=err_msg, duration=duration)
				else:
					log_fh.write("[*] No uncommitted changes in worktree. Recording no_changes.\n")
					record_task_finish(task_id, "no_changes", branch=branch_name, duration=duration)
				return

			receipt = "No automated test gate detected. Clean agent execution."
			gate_argv = detect_gate(worktree_dir, args.gate)
			if gate_argv:
				log_fh.write(f"[*] Running Evidence Gate: {' '.join(gate_argv)}...\n")
				log_fh.flush()
				gate_proc = subprocess.run(gate_argv, cwd=worktree_dir, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
				log_fh.write(gate_proc.stdout)
				log_fh.write(gate_proc.stderr)
				if gate_proc.returncode != 0:
					duration = time.time() - start_time
					err_msg = f"Evidence gate failed ({' '.join(gate_argv)}) with exit code {gate_proc.returncode}"
					log_fh.write(f"[!] {err_msg}\n")
					record_task_finish(task_id, "failed", branch=branch_name, error=err_msg, duration=duration)
					return
				receipt = f"Evidence Gate Passed: `{' '.join(gate_argv)}` exited 0."

			short_title = re.sub(r"[^\w\s-]", "", args.prompt)[:60].strip() or task_id
			commit_proc = subprocess.run(["git", "add", "-A"], cwd=worktree_dir, stdout=log_fh, stderr=log_fh, check=True)
			status_after_add = subprocess.run(["git", "status", "--porcelain"], cwd=worktree_dir, capture_output=True, text=True).stdout.strip()
			if status_after_add:
				subprocess.run(["git", "commit", "-m", f"feat(agent): {short_title}"], cwd=worktree_dir, stdout=log_fh, stderr=log_fh, check=True)
			else:
				log_fh.write("[*] Nothing to commit after add; worker already committed its work.\n")

			if not args.no_push:
				subprocess.run(["git", "push", "-u", "origin", branch_name], cwd=worktree_dir, stdout=log_fh, stderr=log_fh, check=True)

			pr_url = ""
			if not args.no_push and not args.no_pr:
				body_file_path = os.path.join(TMP_BASE, f"pr-body-{task_id}.md")
				with open(body_file_path, "w", encoding="utf-8") as bf:
					bf.write(f"## Autonomous Agent Task: {short_title}\n\n")
					bf.write(f"**Task ID**: `{task_id}`\n")
					bf.write(f"**Evidence Receipt**: {receipt}\n\n")
					bf.write("### Original Prompt\n")
					bf.write(f"> {args.prompt}\n\n")
					bf.write("### Changed Files\n```\n")
					bf.write(changes)
					bf.write("\n```\n")

				pr_cmd = [
					GH_BIN, "pr", "create",
					"--title", f"Agent: {short_title}",
					"--body-file", body_file_path,
					"--head", branch_name,
					"--base", args.base_branch,
				]
				if args.pr_draft:
					pr_cmd.append("--draft")

				pr_proc = subprocess.run(pr_cmd, cwd=worktree_dir, capture_output=True, text=True)
				if os.path.exists(body_file_path):
					os.remove(body_file_path)

				if pr_proc.returncode == 0:
					pr_url = pr_proc.stdout.strip()
					log_fh.write(f"[*] Pull Request created: {pr_url}\n")
				else:
					log_fh.write(f"[!] Failed to create PR: {pr_proc.stderr}\n")

			duration = time.time() - start_time
			record_task_finish(task_id, "passed", branch=branch_name, pr_url=pr_url or None, receipt=receipt, duration=duration)

		except Exception as e:
			duration = time.time() - start_time
			delete_branch = True
			err = f"Execution exception: {str(e)}"
			log_fh.write(f"[!] {err}\n")
			record_task_finish(task_id, "error", branch=branch_name, error=err, duration=duration)
		finally:
			for p in (prompt_file, exit_file):
				if p and os.path.exists(p):
					os.remove(p)
			if worker_left_live:
				# Worker is still live per the user's wish: no worktree removal now; wait for its exit.
				cleanup_after_worker_exit(repo_path, worktree_dir, branch_name, task_id, tmux_session, exit_file, log_fh)
			else:
				log_fh.write("[*] Cleaning up ephemeral worktree...\n")
				cleanup_worktree(repo_path, worktree_dir, branch_name, delete_branch=delete_branch)


if __name__ == "__main__":
	main()
