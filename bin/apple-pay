#!/usr/bin/env python3
import sys
import os
import sqlite3
import argparse
import datetime

# Apple Core Data epoch starts on Jan 1, 2001
APPLE_EPOCH_OFFSET = 978307200

def get_db_path():
	# Look for passes23.sqlite or any passes*.sqlite in ~/Library/Passes/
	passes_dir = os.path.expanduser("~/Library/Passes")
	if not os.path.isdir(passes_dir):
		return None

	# Find passes*.sqlite files
	files = [f for f in os.listdir(passes_dir) if f.startswith("passes") and f.endswith(".sqlite")]
	if not files:
		return None

	# Sort to get the highest version, e.g. passes23.sqlite over passes20.sqlite
	files.sort(reverse=True)
	return os.path.join(passes_dir, files[0])

def search_transactions(query=None, days=None, min_amount=None, max_amount=None, limit=50, csv_output=False):
	db_path = get_db_path()
	if not db_path:
		print("Error: Could not find Apple Wallet/Passes database in ~/Library/Passes/", file=sys.stderr)
		sys.exit(1)

	if not os.path.exists(db_path):
		print(f"Error: Database file does not exist at {db_path}", file=sys.stderr)
		sys.exit(1)

	try:
		# Connect to database in read-only mode to prevent locks and allow concurrent access
		conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
		cursor = conn.cursor()
	except sqlite3.Error as e:
		print(f"Error connecting to database: {e}", file=sys.stderr)
		sys.exit(1)

	# Build SQL query
	sql = """
		SELECT
			pid,
			transaction_date,
			merchant_name,
			amount,
			currency_code,
			locality,
			administrative_area,
			peer_payment_counterpart_handle,
			peer_payment_memo
		FROM payment_transaction
	"""

	conditions = []
	params = []

	if query:
		# Search merchant_name, peer_payment_memo, or peer_payment_counterpart_handle
		conditions.append("(merchant_name LIKE ? OR peer_payment_memo LIKE ? OR peer_payment_counterpart_handle LIKE ?)")
		like_query = f"%{query}%"
		params.extend([like_query, like_query, like_query])

	if days is not None and days > 0:
		# Calculate minimum date in Apple Core Data epoch seconds
		cutoff_date = datetime.datetime.now() - datetime.timedelta(days=days)
		cutoff_apple_epoch = int(cutoff_date.timestamp() - APPLE_EPOCH_OFFSET)
		conditions.append("transaction_date >= ?")
		params.append(cutoff_apple_epoch)

	if min_amount is not None:
		# Convert major unit (dollars) to micro-units (multiply by 10000)
		conditions.append("amount >= ?")
		params.append(int(min_amount * 10000))

	if max_amount is not None:
		conditions.append("amount <= ?")
		params.append(int(max_amount * 10000))

	if conditions:
		sql += " WHERE " + " AND ".join(conditions)

	sql += " ORDER BY transaction_date DESC"

	if limit is not None and limit > 0:
		sql += " LIMIT ?"
		params.append(limit)

	try:
		cursor.execute(sql, params)
		rows = cursor.fetchall()
	except sqlite3.Error as e:
		print(f"Error executing query: {e}", file=sys.stderr)
		conn.close()
		sys.exit(1)

	if not rows:
		print("No transactions found matching the criteria.")
		conn.close()
		return

	if csv_output:
		import csv
		writer = csv.writer(sys.stdout)
		writer.writerow(["ID", "Date", "Merchant / Contact", "Amount", "Currency", "Location", "Memo"])
		for row in rows:
			pid, date_raw, merchant, amount_raw, currency, locality, admin_area, peer_handle, peer_memo = row

			# Date conversion
			date_obj = datetime.datetime.fromtimestamp(date_raw + APPLE_EPOCH_OFFSET)
			date_str = date_obj.strftime("%Y-%m-%d %H:%M:%S")

			# Amount conversion
			amount = amount_raw / 10000.0 if amount_raw is not None else 0.0

			# Display name
			disp_name = merchant
			if not disp_name:
				if peer_handle:
					disp_name = f"Peer Transfer: {peer_handle}"
				else:
					disp_name = "Unknown Merchant"

			location = f"{locality}, {admin_area}" if locality and admin_area else (locality or admin_area or "")

			writer.writerow([pid, date_str, disp_name, f"{amount:.2f}", currency, location, peer_memo or ""])
	else:
		print(f"\nFound {len(rows)} Apple Pay transaction(s):")
		print("-" * 120)
		print(f"{'Date':<20} | {'Merchant / Contact':<40} | {'Amount':<12} | {'Location':<25} | {'Memo':<15}")
		print("-" * 120)
		for row in rows:
			pid, date_raw, merchant, amount_raw, currency, locality, admin_area, peer_handle, peer_memo = row

			# Date conversion
			date_obj = datetime.datetime.fromtimestamp(date_raw + APPLE_EPOCH_OFFSET)
			date_str = date_obj.strftime("%Y-%m-%d %H:%M:%S")

			# Amount conversion
			amount = amount_raw / 10000.0 if amount_raw is not None else 0.0
			amount_str = f"{amount:.2f} {currency}"

			# Display name
			disp_name = merchant
			if not disp_name:
				if peer_handle:
					disp_name = f"Peer Transfer: {peer_handle}"
				else:
					disp_name = "Unknown Merchant"

			location = f"{locality}, {admin_area}" if locality and admin_area else (locality or admin_area or "")
			memo = peer_memo or ""

			# Truncate fields for table display
			disp_date = date_str[:20]
			disp_name = disp_name[:40]
			disp_amount = amount_str[:12]
			disp_loc = location[:25]
			disp_memo = memo[:15]

			print(f"{disp_date:<20} | {disp_name:<40} | {disp_amount:<12} | {disp_loc:<25} | {disp_memo:<15}")
		print("-" * 120)

	conn.close()

def main():
	parser = argparse.ArgumentParser(description="Query and search local Apple Pay transactions on macOS")
	parser.add_argument("search_query", nargs="?", help="Search term for merchant or peer contact/memo (positional)")
	parser.add_argument("-q", "--query", help="Search term for merchant or peer contact/memo")
	parser.add_argument("-d", "--days", type=int, help="Search back N days (e.g. 30)")
	parser.add_argument("-min", "--min-amount", type=float, help="Minimum amount (e.g. 10.00)")
	parser.add_argument("-max", "--max-amount", type=float, help="Maximum amount (e.g. 150.00)")
	parser.add_argument("-l", "--limit", type=int, default=50, help="Limit results (default: 50, use 0 for unlimited)")
	parser.add_argument("--csv", action="store_true", help="Output in CSV format")

	args = parser.parse_args()
	query = args.query or args.search_query

	search_transactions(
		query=query,
		days=args.days,
		min_amount=args.min_amount,
		max_amount=args.max_amount,
		limit=args.limit if args.limit > 0 else None,
		csv_output=args.csv
	)

if __name__ == "__main__":
	main()
