#!/usr/bin/env -S uv run --script
# /// script
# dependencies = [
# 	"mcp<2",
# 	"patchright",
# ]
# ///
"""FastMCP server providing browser automation tools over CDP / stealth Chromium using patchright."""

import argparse
import asyncio
import datetime
import os
import signal
import sys
import time
from typing import Optional
from mcp.server.fastmcp import FastMCP
from patchright.async_api import Browser, BrowserContext, Page, async_playwright

mcp = FastMCP("brave-browser")

CDP_PORT = int(os.environ.get("BRAVE_CDP_PORT", "9222"))
CDP_URL = f"http://127.0.0.1:{CDP_PORT}"
PROFILE_DIR = os.path.expanduser(os.environ.get("BRAVE_PROFILE_DIR", "~/.agent-chromium-profile"))
IDLE_TIMEOUT_SECONDS = int(os.environ.get("BRAVE_MCP_IDLE_TIMEOUT", "300"))


class BraveSessionManager:
	"""Manages dedicated stealth Chromium browser or CDP connection for AI agents."""

	def __init__(self, cdp_url: str):
		self.cdp_url = cdp_url
		self._playwright = None
		self._browser: Optional[Browser] = None
		self._context: Optional[BrowserContext] = None
		self._active_page: Optional[Page] = None
		self._idle_task: Optional[asyncio.Task] = None

	def _touch_activity(self):
		if self._idle_task is not None and not self._idle_task.done():
			self._idle_task.cancel()
		try:
			loop = asyncio.get_running_loop()
			self._idle_task = loop.create_task(self._idle_watchdog())
		except RuntimeError:
			pass

	async def _idle_watchdog(self):
		try:
			await asyncio.sleep(IDLE_TIMEOUT_SECONDS)
			# Auto-stop the driver on idle if attached via CDP or if no persistent context is open
			if self._browser is not None or self._context is None:
				await self.close()
		except asyncio.CancelledError:
			pass

	async def close(self):
		"""Cleanly stop the patchright node driver and release browser handles."""
		if (
			self._idle_task is not None
			and not self._idle_task.done()
			and asyncio.current_task() is not self._idle_task
		):
			self._idle_task.cancel()
		self._idle_task = None
		self._context = None
		self._browser = None
		self._active_page = None
		if self._playwright is not None:
			try:
				await self._playwright.stop()
			except Exception:
				pass
			finally:
				self.close_sync()

	def close_sync(self):
		"""Synchronously terminate the patchright node driver subprocess if still alive."""
		if self._playwright is None:
			return
		try:
			proc = getattr(self._playwright._impl_obj._connection._transport, "_proc", None)
			if proc is not None and getattr(proc, "pid", None):
				os.kill(proc.pid, signal.SIGTERM)
		except Exception:
			pass
		self._playwright = None

	async def get_context(self) -> BrowserContext:
		self._touch_activity()
		if self._playwright is None:
			self._playwright = await async_playwright().start()

		# Check if an existing context is still alive
		if self._context is not None:
			try:
				if self._browser is not None and not self._browser.is_connected():
					self._browser = None
					self._context = None
				elif hasattr(self._context, "is_closed") and self._context.is_closed():
					self._context = None
				else:
					_ = self._context.pages
					return self._context
			except Exception:
				self._context = None
				self._browser = None

		# 1. Try attaching to existing CDP session (e.g., if launched on port 9222)
		try:
			self._browser = await self._playwright.chromium.connect_over_cdp(
				self.cdp_url,
				timeout=1500,
			)
			if self._browser.contexts:
				self._context = self._browser.contexts[0]
				return self._context
		except Exception:
			self._browser = None

		# 2. Launch dedicated standalone stealth Chromium with CDP remote debugging port enabled
		os.makedirs(PROFILE_DIR, exist_ok=True)
		browser_args = [
			"--disable-blink-features=AutomationControlled",
			f"--remote-debugging-port={CDP_PORT}",
		]
		try:
			self._context = await self._playwright.chromium.launch_persistent_context(
				user_data_dir=PROFILE_DIR,
				headless=False,
				args=browser_args,
			)
		except Exception as exc:
			if "Opening in existing browser session" in str(exc) or "already in use" in str(exc):
				# The browser might be in the middle of launching; retry connecting over CDP
				for _ in range(3):
					await asyncio.sleep(0.5)
					try:
						self._browser = await self._playwright.chromium.connect_over_cdp(
							self.cdp_url,
							timeout=1500,
						)
						if self._browser.contexts:
							self._context = self._browser.contexts[0]
							return self._context
					except Exception:
						pass

				fallback_dir = f"{PROFILE_DIR}-{os.getpid()}"
				os.makedirs(fallback_dir, exist_ok=True)
				self._context = await self._playwright.chromium.launch_persistent_context(
					user_data_dir=fallback_dir,
					headless=False,
					args=["--disable-blink-features=AutomationControlled"],
				)
			else:
				raise
		return self._context

	async def get_pages(self) -> list[Page]:
		context = await self.get_context()
		return [p for p in context.pages if not p.is_closed()]

	async def get_active_page(self) -> Page:
		try:
			context = await self.get_context()
			if self._active_page is not None and not self._active_page.is_closed():
				return self._active_page

			pages = await self.get_pages()
			# If this session attached via CDP to an already-active browser session
			if self._browser is not None:
				# Always open a new dedicated tab for this session so we do not hijack other sessions
				self._active_page = await context.new_page()
				return self._active_page

			# Primary launcher session
			if pages:
				self._active_page = pages[0]
			else:
				self._active_page = await context.new_page()
			return self._active_page
		except Exception as exc:
			if "closed" in str(exc).lower():
				# Browser window was killed externally; reset and relaunch
				await self.close()
				context = await self.get_context()
				pages = await self.get_pages()
				if pages:
					self._active_page = pages[0]
				else:
					self._active_page = await context.new_page()
				return self._active_page
			raise

	def set_active_page(self, page: Page):
		self._active_page = page

	async def resolve_page(self, tab: int = -1) -> Page:
		pages = await self.get_pages()
		if tab >= 0:
			if tab >= len(pages):
				raise ValueError(f"Invalid tab index {tab}. Total open tabs: {len(pages)}")
			return pages[tab]
		return await self.get_active_page()


session = BraveSessionManager(CDP_URL)


@mcp.tool()
async def brave_status() -> str:
	"""Check connection status to Brave Browser and list all open tabs."""
	try:
		pages = await session.get_pages()
		active_page = await session.get_active_page()
		lines = [f"Connected to browser session at {CDP_URL}"]
		lines.append(f"Total open tabs: {len(pages)}")
		for idx, page in enumerate(pages):
			active_marker = " (ACTIVE in this session)" if page == active_page else ""
			title = await page.title()
			lines.append(f"\t[{idx}] {title} - {page.url}{active_marker}")
		return "\n".join(lines)
	except Exception as exc:
		return f"Disconnected: {exc}"


@mcp.tool()
async def brave_navigate(
	url: str,
	new_tab: bool = False,
	tab: int = -1,
	timeout_ms: int = 30000,
	wait_until: str = "commit",
) -> str:
	"""Navigate a Brave tab to a specific URL. Use wait_until='commit' for ultra-fast navigation (default), or 'domcontentloaded'/'load'."""
	t0 = time.perf_counter()
	try:
		context = await session.get_context()
		if new_tab:
			page = await context.new_page()
			session.set_active_page(page)
		else:
			page = await session.resolve_page(tab)

		# Ensure URL has protocol
		if not url.startswith("http://") and not url.startswith("https://") and not url.startswith("about:"):
			url = "https://" + url

		valid_waits = {"commit", "domcontentloaded", "load", "networkidle"}
		wait_mode = wait_until if wait_until in valid_waits else "domcontentloaded"

		response = await page.goto(url, timeout=timeout_ms, wait_until=wait_mode)
		status = response.status if response else "loaded"
		title = await page.title()
		pages = await session.get_pages()
		target_idx = pages.index(page) if page in pages else -1
		elapsed = int((time.perf_counter() - t0) * 1000)
		return f"Navigated tab [{target_idx}] to '{url}' [HTTP {status}] ({elapsed}ms, wait_until={wait_mode}) - Title: '{title}'"
	except Exception as exc:
		return f"Navigation error: {exc}"


@mcp.tool()
async def brave_new_tab(url: str = "about:blank") -> str:
	"""Open a new browser tab and navigate to url (default 'about:blank'). Returns the new tab index."""
	return await brave_navigate(url=url, new_tab=True)


@mcp.tool()
async def brave_snapshot(selector: str = "body", max_elements: int = 80, tab: int = -1) -> str:
	"""Extract interactive elements (buttons, inputs, links, selects, dropdowns) with exact selectors and values in a single high-speed call."""
	t0 = time.perf_counter()
	try:
		page = await session.resolve_page(tab)
		js_code = """() => {
			const isVisible = (el) => {
				const style = window.getComputedStyle(el);
				return style && style.visibility !== 'hidden' && style.display !== 'none' && el.offsetWidth > 0 && el.offsetHeight > 0;
			};
			const nodes = Array.from(document.querySelectorAll(
				'button, input, select, textarea, a[href], [role="button"], [role="combobox"], [role="option"], [role="tab"], [role="menuitem"]'
			)).filter(isVisible);

			return nodes.slice(0, 100).map((el, i) => {
				const tag = el.tagName.toLowerCase();
				const id = el.id ? `#${el.id}` : '';
				const name = el.name ? `[name="${el.name}"]` : '';
				const type = el.type ? `[type="${el.type}"]` : '';
				const role = el.getAttribute('role') ? `[role="${el.getAttribute('role')}"]` : '';
				const aria = el.getAttribute('aria-label') ? `aria-label="${el.getAttribute('aria-label')}"` : '';
				const val = el.value !== undefined && el.value !== '' ? `val="${el.value}"` : '';
				const text = (el.innerText || el.textContent || '').trim().replace(/\\s+/g, ' ').slice(0, 60);

				let selector = el.id ? `#${el.id}` : (el.name ? `${tag}[name="${el.name}"]` : (el.getAttribute('data-testid') ? `[data-testid="${el.getAttribute('data-testid')}"]` : ''));
				if (!selector && el.className && typeof el.className === 'string') {
					const firstClass = el.className.split(' ').filter(c => c && !c.includes(':'))[0];
					if (firstClass) selector = `${tag}.${firstClass}`;
				}
				if (!selector) selector = tag;

				return {
					index: i,
					tag,
					selector,
					text,
					attrs: [id, name, type, role, aria, val].filter(Boolean).join(' ')
				};
			});
		}"""
		elements = await page.evaluate(js_code)
		elapsed_ms = int((time.perf_counter() - t0) * 1000)

		if not elements:
			return f"No interactive elements found on {page.url} ({elapsed_ms}ms)"

		elements = elements[:max_elements]
		lines = [f"Interactive elements snapshot for {page.url} ({elapsed_ms}ms, {len(elements)} items):", ""]
		lines.append("| # | Tag | Selector | Text / Details |")
		lines.append("|---|---|---|---|")
		for el in elements:
			desc = f"{el['text']} ({el['attrs']})" if el['attrs'] else el['text']
			lines.append(f"| {el['index']} | `<{el['tag']}>` | `{el['selector']}` | {desc} |")
		return "\n".join(lines)
	except Exception as exc:
		return f"Error capturing snapshot: {exc}"


@mcp.tool()
async def brave_batch(actions: list[dict], tab: int = -1) -> str:
	"""Execute a pipeline of browser actions sequentially in a single turn for maximum speed (10-100x faster than roundtrips).

	Supported action types in the dict:
	- {"action": "click", "selector": "#btn", "timeout_ms": 3000}
	- {"action": "fill", "selector": "#input", "text": "hello", "timeout_ms": 3000}
	- {"action": "type", "selector": "#input", "text": "hello", "press_enter": True, "timeout_ms": 3000}
	- {"action": "select", "selector": "select#country", "value": "CA", "timeout_ms": 3000}
	- {"action": "press", "key": "Enter"}
	- {"action": "wait_for", "selector": ".modal", "timeout_ms": 3000, "state": "visible"}
	- {"action": "sleep", "ms": 500}
	- {"action": "evaluate", "expression": "window.scrollTo(0, 500)"}
	"""
	t0 = time.perf_counter()
	try:
		page = await session.resolve_page(tab)
		results = []
		for idx, item in enumerate(actions):
			act = item.get("action", "").lower()
			timeout = item.get("timeout_ms", 4000)

			if act == "click":
				sel = item["selector"]
				await page.locator(sel).first.click(timeout=timeout)
				results.append(f"[{idx}] click '{sel}': OK")

			elif act == "fill":
				sel = item["selector"]
				text = item.get("text", "")
				await page.locator(sel).first.fill(text, timeout=timeout)
				results.append(f"[{idx}] fill '{sel}': OK")

			elif act == "type":
				sel = item["selector"]
				text = item.get("text", "")
				press_enter = item.get("press_enter", False)
				loc = page.locator(sel).first
				await loc.type(text, timeout=timeout)
				if press_enter:
					await loc.press("Enter")
				results.append(f"[{idx}] type '{sel}' ({'with Enter' if press_enter else ''}): OK")

			elif act == "select":
				sel = item["selector"]
				val = item.get("value", "")
				await page.locator(sel).first.select_option(val, timeout=timeout)
				results.append(f"[{idx}] select '{sel}' option '{val}': OK")

			elif act == "press":
				key = item.get("key", "Enter")
				await page.keyboard.press(key)
				results.append(f"[{idx}] press '{key}': OK")

			elif act == "wait_for":
				sel = item["selector"]
				state = item.get("state", "visible")
				await page.locator(sel).first.wait_for(state=state, timeout=timeout)
				results.append(f"[{idx}] wait_for '{sel}' ({state}): OK")

			elif act == "sleep":
				ms = item.get("ms", 200)
				await asyncio.sleep(ms / 1000.0)
				results.append(f"[{idx}] sleep {ms}ms: OK")

			elif act == "evaluate":
				expr = item.get("expression", "")
				res = await page.evaluate(expr)
				results.append(f"[{idx}] evaluate: {res}")

			else:
				results.append(f"[{idx}] Unknown action '{act}': SKIPPED")

		elapsed = int((time.perf_counter() - t0) * 1000)
		return f"Batch completed ({len(results)} steps in {elapsed}ms) on {page.url}:\n" + "\n".join(results)
	except Exception as exc:
		elapsed = int((time.perf_counter() - t0) * 1000)
		return f"Batch failed after {elapsed}ms: {exc}"


@mcp.tool()
async def brave_get_content(
	selector: str = "body",
	max_length: int = 4000,
	interactive_only: bool = False,
	tab: int = -1,
) -> str:
	"""Extract visible text content or interactive elements from the active tab. Set interactive_only=True for compact semantic elements snapshot."""
	try:
		if interactive_only:
			return await brave_snapshot(selector=selector, tab=tab)

		page = await session.resolve_page(tab)
		element = page.locator(selector).first
		if await element.count() == 0:
			return f"Element '{selector}' not found on page {page.url}"

		text = await element.inner_text()
		text = text.strip()
		if len(text) > max_length:
			truncated = text[:max_length]
			return f"[Showing first {max_length} characters of {len(text)}]:\n{truncated}\n... (truncated)"
		return text if text else "(Page element contains no visible text)"
	except Exception as exc:
		return f"Error extracting content: {exc}"


@mcp.tool()
async def brave_click(selector: str, tab: int = -1, timeout_ms: int = 5000) -> str:
	"""Click an element on the active page or specified tab index by CSS selector, text, or XPath."""
	try:
		page = await session.resolve_page(tab)
		locator = page.locator(selector).first
		await locator.click(timeout=timeout_ms)
		return f"Clicked element matching '{selector}' on {page.url}"
	except Exception as exc:
		return f"Error clicking element '{selector}': {exc}"


@mcp.tool()
async def brave_type(selector: str, text: str, clear_first: bool = True, press_enter: bool = False, tab: int = -1, timeout_ms: int = 5000) -> str:
	"""Type text into an input field or textarea on the active page or specified tab index."""
	try:
		page = await session.resolve_page(tab)
		locator = page.locator(selector).first
		if clear_first:
			await locator.fill(text, timeout=timeout_ms)
		else:
			await locator.type(text, timeout=timeout_ms)

		if press_enter:
			await locator.press("Enter")
			return f"Typed text into '{selector}' and pressed Enter"
		return f"Typed text into '{selector}'"
	except Exception as exc:
		return f"Error typing into '{selector}': {exc}"


@mcp.tool()
async def brave_press_key(key: str, tab: int = -1) -> str:
	"""Press a keyboard key on the active page or specified tab index (e.g., 'Enter', 'Tab', 'Escape')."""
	try:
		page = await session.resolve_page(tab)
		await page.keyboard.press(key)
		return f"Pressed key '{key}' on {page.url}"
	except Exception as exc:
		return f"Error pressing key '{key}': {exc}"


@mcp.tool()
async def brave_scroll(direction: str = "down", amount: int = 600, tab: int = -1) -> str:
	"""Scroll the active page or specified tab index up or down (direction: 'up' or 'down', amount in pixels)."""
	try:
		page = await session.resolve_page(tab)
		delta = amount if direction.lower() == "down" else -amount
		await page.mouse.wheel(0, delta)
		return f"Scrolled {direction} by {amount}px"
	except Exception as exc:
		return f"Error scrolling: {exc}"


@mcp.tool()
async def brave_screenshot(save_path: str = "", tab: int = -1) -> str:
	"""Capture a screenshot of the active page view or specified tab index and return the file path."""
	try:
		page = await session.resolve_page(tab)
		if not save_path:
			timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
			save_path = f"/tmp/brave_screenshot_{timestamp}.png"

		await page.screenshot(path=save_path, full_page=False)
		title = await page.title()
		return f"Screenshot saved to: {save_path}\nPage Title: {title}\nURL: {page.url}"
	except Exception as exc:
		return f"Error taking screenshot: {exc}"


@mcp.tool()
async def brave_evaluate_js(expression: str, tab: int = -1) -> str:
	"""Evaluate a JavaScript expression in the active page or specified tab index and return the result."""
	try:
		page = await session.resolve_page(tab)
		result = await page.evaluate(expression)
		return f"Result: {result}"
	except Exception as exc:
		return f"JavaScript execution error: {exc}"


@mcp.tool()
async def brave_switch_tab(index: int) -> str:
	"""Switch focus to an open tab by its numeric index (see brave_status)."""
	try:
		pages = await session.get_pages()
		if index < 0 or index >= len(pages):
			return f"Invalid tab index {index}. Total open tabs: {len(pages)}"

		page = pages[index]
		session.set_active_page(page)
		await page.bring_to_front()
		title = await page.title()
		return f"Switched to tab [{index}]: '{title}' ({page.url})"
	except Exception as exc:
		return f"Error switching tab: {exc}"


@mcp.tool()
async def brave_close_tab(index: int = -1) -> str:
	"""Close a tab by index (-1 closes active tab, -99 or closing last tab terminates the browser window)."""
	try:
		if index == -99:
			return await brave_close_browser()

		pages = await session.get_pages()
		if not pages:
			return await brave_close_browser()

		if index == -1:
			page = await session.get_active_page()
			target_index = pages.index(page) if page in pages else -1
		else:
			if index < 0 or index >= len(pages):
				return f"Invalid tab index {index}. Total open tabs: {len(pages)}"
			page = pages[index]
			target_index = index

		url = page.url
		await page.close()
		if page == session._active_page:
			session._active_page = None

		remaining = await session.get_pages()
		if not remaining:
			await brave_close_browser()
			return f"Closed last tab [{target_index}] ({url}). Browser window completely closed."
		return f"Closed tab [{target_index}] ({url}). Remaining open tabs: {len(remaining)}"
	except Exception as exc:
		return f"Error closing tab: {exc}"


@mcp.tool()
async def brave_close_browser() -> str:
	"""Completely close the browser window, terminate the browser process, and release all resources."""
	try:
		if session._context is not None:
			try:
				await session._context.close()
			except Exception:
				pass
		if session._browser is not None:
			try:
				await session._browser.close()
			except Exception:
				pass
		await session.close()
		return "Browser completely closed and all resources released."
	except Exception as exc:
		return f"Error closing browser: {exc}"


def main():
	parser = argparse.ArgumentParser(
		description="FastMCP server providing browser automation tools over CDP or standalone stealth Chromium using patchright."
	)
	parser.parse_args()

	def _handle_signal(signum, _frame):
		raise SystemExit(0)

	for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
		signal.signal(sig, _handle_signal)

	try:
		mcp.run()
	except (KeyboardInterrupt, SystemExit):
		pass
	finally:
		session.close_sync()
		os._exit(0)


if __name__ == "__main__":
	main()
