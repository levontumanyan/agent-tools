#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""
Inspect and gracefully cull idle OpenCode TUI sessions in any terminal.

Terminal-agnostic: works in iTerm2, cmux, Ghostty, Terminal.app, tmux, etc.
A session is culled when conversation and process idle both exceed --hours and
nothing wrote to its tty within --tty-grace-min (default 15) — tty mtime is an
in-use grace, not a gate, since terminal redraws from layout changes reset it.
The tab stays open with a recap and the resume command printed into it.
"""

import argparse
import json
import os
import re
import shutil
import signal
import sqlite3
import subprocess
import sys
import textwrap
import time
from datetime import datetime, timezone
from pathlib import Path

DB_PATH = Path.home() / ".local" / "share" / "opencode" / "opencode.db"
SESSION_WINDOW_SEC = 3600.0


def _now_ms() -> int:
	return int(time.time() * 1000)


def parse_etime(s: str) -> float:
	"""Parse POSIX etime [[dd-]hh:]mm:ss into total seconds."""
	parts = s.strip().split("-")
	if len(parts) == 2:
		days = int(parts[0])
		time_str = parts[1]
	else:
		days = 0
		time_str = parts[0]
	t_parts = [int(p) for p in time_str.split(":")]
	if len(t_parts) == 3:
		h, m, sec = t_parts
	elif len(t_parts) == 2:
		h, m, sec = 0, int(t_parts[0]), int(t_parts[1])
	else:
		h, m, sec = 0, 0, int(t_parts[0])
	return days * 86400.0 + h * 3600.0 + m * 60.0 + sec


def get_pids_elapsed_sec(pids: list[int]) -> dict[int, float]:
	"""Return mapping of pid -> elapsed running time in seconds via ps etime."""
	if not pids:
		return {}
	try:
		res = subprocess.run(
			["ps", "-o", "pid=,etime=", "-p", ",".join(str(p) for p in pids)],
			capture_output=True,
			text=True,
		)
	except Exception:
		return {}
	out = {}
	for line in res.stdout.splitlines():
		parts = line.strip().split()
		if len(parts) == 2:
			try:
				out[int(parts[0])] = parse_etime(parts[1])
			except Exception:
				pass
	return out


def get_tty_idle_sec(tty: str) -> float:
	"""Return seconds since the TTY was last active (keystroke or output)."""
	if not tty or not os.path.exists(tty):
		return float("inf")
	try:
		st = os.stat(tty)
		return max(0.0, time.time() - max(st.st_atime, st.st_mtime))
	except Exception:
		return float("inf")


def get_live_processes() -> list[dict]:
	"""Find live OpenCode TUI processes: [{pid, tty, cmd, argv_sid, cwd}]."""
	out = []
	ps_out = subprocess.check_output(["ps", "-o", "pid=,tty=,command=", "-ax"], text=True)
	for line in ps_out.splitlines():
		parts = line.strip().split(None, 2)
		if len(parts) != 3:
			continue
		pid_str, tty_short, cmd = parts
		if tty_short == "??":
			continue
		exe = os.path.basename(cmd.split(None, 1)[0])
		if exe != "opencode":
			continue
		if re.search(r"\b(serve|daemon)\b", cmd):
			continue
		m = re.search(r"(?:^|\s)(?:-s|--session)[= ](ses_[A-Za-z0-9]+)", cmd)
		out.append({
			"pid": int(pid_str),
			"tty": "/dev/" + tty_short,
			"cmd": cmd,
			"argv_sid": m.group(1) if m else "",
			"cwd": "",
		})

	if out:
		try:
			lsof = subprocess.check_output(
				["lsof", "-a", "-p", ",".join(str(p["pid"]) for p in out), "-d", "cwd", "-Fn"],
				text=True,
				stderr=subprocess.DEVNULL,
			)
			cur = None
			for line in lsof.splitlines():
				if line.startswith("p"):
					cur = int(line[1:])
				elif line.startswith("n/") and cur:
					for proc in out:
						if proc["pid"] == cur:
							proc["cwd"] = line[1:].strip()
		except Exception:
			pass
	return out


def db_readonly() -> sqlite3.Connection | None:
	if not DB_PATH.exists():
		return None
	try:
		return sqlite3.connect(f"file:{DB_PATH}?mode=ro", uri=True)
	except Exception:
		return None


def sessions_for_directory(cur: sqlite3.Cursor, directory: str) -> list[dict]:
	"""Non-subagent, non-archived sessions for a directory, most recent first."""
	rows = cur.execute(
		"""
		SELECT id, COALESCE(title, ''), time_updated, time_created,
		       tokens_input, tokens_output, cost, COALESCE(model, '')
		FROM session_v2
		WHERE directory = ? AND parent_id IS NULL AND time_archived IS NULL
		ORDER BY COALESCE(time_updated, time_created) DESC
		""",
		(directory,),
	).fetchall()
	return [
		{
			"id": r[0],
			"title": r[1],
			"updated_ms": r[2],
			"created_ms": r[3],
			"tokens_in": r[4] or 0,
			"tokens_out": r[5] or 0,
			"cost": r[6] or 0.0,
			"model": r[7],
		}
		for r in rows
	]


def attribute_sessions(cur: sqlite3.Cursor, procs: list[dict]) -> None:
	"""Attach the displayed session to each live TUI (in-place, key 'session').

	Exact when argv carries -s/--session. Otherwise match a session created
	shortly after the process started; fall back to the most recent unclaimed
	session in the same directory (marked uncertain).
	"""
	claimed: set[str] = set()
	elapsed = get_pids_elapsed_sec([p["pid"] for p in procs])
	for proc in procs:
		proc["elapsed_sec"] = elapsed.get(proc["pid"], float("inf"))
		proc["session"] = None
		proc["certain"] = False
		if proc["argv_sid"] and not proc["cwd"]:
			try:
				row = cur.execute(
					"SELECT directory FROM session_v2 WHERE id = ?", (proc["argv_sid"],)
				).fetchone()
				if row:
					proc["cwd"] = row[0]
			except Exception:
				pass

	for proc in procs:
		if proc["argv_sid"] and proc["argv_sid"] not in claimed:
			try:
				row = cur.execute(
					"""
					SELECT id, COALESCE(title, ''), time_updated, time_created,
					       tokens_input, tokens_output, cost, COALESCE(model, '')
					FROM session_v2 WHERE id = ?
					""",
					(proc["argv_sid"],),
				).fetchone()
			except Exception:
				row = None
			claimed.add(proc["argv_sid"])
			if row:
				proc["session"] = {
					"id": row[0],
					"title": row[1],
					"updated_ms": row[2],
					"created_ms": row[3],
					"tokens_in": row[4] or 0,
					"tokens_out": row[5] or 0,
					"cost": row[6] or 0.0,
					"model": row[7],
					"certain": True,
				}

	by_dir: dict[str, list[dict]] = {}
	for proc in procs:
		if proc["cwd"] and not proc["session"]:
			by_dir.setdefault(proc["cwd"], []).append(proc)

	for directory, group in by_dir.items():
		try:
			candidates = sessions_for_directory(cur, directory)
		except Exception:
			candidates = []
		for proc in group:
			start_ms = _now_ms() - int(proc["elapsed_sec"] * 1000) if proc["elapsed_sec"] != float("inf") else 0
			for ses in candidates:
				if ses["id"] in claimed:
					continue
				if start_ms and ses["created_ms"] and 0 <= ses["created_ms"] - start_ms <= SESSION_WINDOW_SEC * 1000:
					proc["session"] = ses | {"certain": True}
					claimed.add(ses["id"])
					break
		for proc in group:
			if proc["session"]:
				continue
			for ses in candidates:
				if ses["id"] not in claimed:
					proc["session"] = ses | {"certain": False}
					claimed.add(ses["id"])
					break


def get_recap(cur: sqlite3.Cursor, sid: str) -> dict:
	"""First/last user prompt, last assistant reply, and turn count from the DB."""
	recap = {"first_user": "", "last_user": "", "last_agent": "", "turns": 0}
	if not sid:
		return recap

	def _extract(kind: str, data: str, limit: int) -> str:
		try:
			obj = json.loads(data)
		except Exception:
			return ""
		if kind == "user":
			return _clean_text(obj.get("text", ""), limit)
		if kind == "assistant":
			parts = [
				p.get("text", "")
				for p in obj.get("content", [])
				if isinstance(p, dict) and p.get("type") == "text"
			]
			return _clean_text(" ".join(parts), limit)
		return ""

	try:
		row = cur.execute(
			"SELECT data FROM session_message WHERE session_id = ? AND type = 'user' ORDER BY seq ASC LIMIT 1",
			(sid,),
		).fetchone()
		if row:
			recap["first_user"] = _extract("user", row[0], 240)
		row = cur.execute(
			"SELECT data FROM session_message WHERE session_id = ? AND type = 'user' ORDER BY seq DESC LIMIT 1",
			(sid,),
		).fetchone()
		if row:
			recap["last_user"] = _extract("user", row[0], 240)
		recap["turns"] = cur.execute(
			"SELECT COUNT(*) FROM session_message WHERE session_id = ? AND type = 'user'",
			(sid,),
		).fetchone()[0]
		row = cur.execute(
			"SELECT data FROM session_message WHERE session_id = ? AND type = 'assistant' "
			"ORDER BY seq DESC LIMIT 1",
			(sid,),
		).fetchone()
		if row:
			recap["last_agent"] = _extract("assistant", row[0], 480)
	except Exception:
		pass
	return recap


def _clean_text(text: str, limit: int = 240) -> str:
	if not text:
		return ""
	cleaned = " ".join(text.split())
	if len(cleaned) <= limit:
		return cleaned
	cut = cleaned[: limit - 1].rsplit(" ", 1)[0]
	return (cut if len(cut) > limit // 2 else cleaned[: limit - 1]).rstrip() + "…"


def _format_ts(ms: int) -> str:
	if not ms:
		return ""
	try:
		return datetime.fromtimestamp(ms / 1000).strftime("%Y-%m-%d %H:%M")
	except Exception:
		return ""


def graceful_exit_opencode(pid: int, tty: str) -> str:
	"""Quit the TUI: SIGINT (clean for opencode, session persists), SIGTERM fallback.

	Note: writing \\x03 to the tty does NOT quit opencode's raw-mode TUI (it is
	consumed as an input byte), so go straight to SIGINT.
	"""
	try:
		os.kill(pid, signal.SIGINT)
	except ProcessLookupError:
		return "already-exited"
	for _ in range(25):
		time.sleep(0.1)
		try:
			os.kill(pid, 0)
		except OSError:
			return "SIGINT"
	# Guard against PID reuse: only escalate if the pid is still an opencode TUI.
	try:
		still_ours = "opencode" in subprocess.check_output(
			["ps", "-o", "command=", "-p", str(pid)],
			text=True,
			stderr=subprocess.DEVNULL,
		)
	except Exception:
		still_ours = False
	if not still_ours:
		return "SIGINT"
	try:
		os.kill(pid, signal.SIGTERM)
	except OSError:
		return "already-exited"
	return "SIGTERM"


def get_cmux_env(pid: int) -> tuple[str, str]:
	"""Inspect process environment via ps eww for CMUX_SURFACE_ID / CMUX_SOCKET_PATH."""
	try:
		out = subprocess.check_output(
			["ps", "eww", "-o", "command=", "-p", str(pid)],
			text=True,
			stderr=subprocess.DEVNULL,
		)
	except Exception:
		return "", ""
	surf_m = re.search(r"(?:^|\s)CMUX_SURFACE_ID=([^\s]+)", out)
	sock_m = re.search(r"(?:^|\s)CMUX_SOCKET_PATH=([^\s]+)", out)
	return (surf_m.group(1) if surf_m else ""), (sock_m.group(1) if sock_m else "")


def resolve_cmux_bin() -> str:
	found = shutil.which("cmux")
	if found:
		return found
	bundled = Path("/Applications/cmux.app/Contents/Resources/bin/cmux")
	return str(bundled) if bundled.exists() else ""


def _wrap_field(label: str, text: str, width: int = 84) -> list[str]:
	wrapped = textwrap.wrap(text, width=width) or [text]
	out = [f"  \033[1;34m{label:<13}\033[0m {wrapped[0]}"]
	for cont in wrapped[1:]:
		out.append(f"{' ' * 16}{cont}")
	return out


def write_tty_recap(tty: str, proc: dict, idle_hr: float, recap: dict, surface_id: str = "", socket_path: str = "") -> None:
	"""Write the session summary into the tab's TTY after the TUI exits."""
	ses = proc.get("session") or {}
	if not tty or not os.path.exists(tty):
		return
	short_cwd = proc["cwd"].replace(str(Path.home()), "~") if proc["cwd"] else ""
	rule = "\033[2m" + ("─" * 72) + "\033[0m"
	lines = [
		"",
		rule,
		f"\033[1;36m[opencode-sessions]\033[0m \033[1mSession Culled\033[0m ({idle_hr:.1f}h idle)",
	]
	if ses.get("title"):
		lines.append(f"  \033[1;34m{'Title:':<13}\033[0m \033[1m{ses['title']}\033[0m")
	if short_cwd:
		lines.append(f"  \033[1;34m{'Directory:':<13}\033[0m {short_cwd}")

	stats = []
	if recap.get("turns"):
		stats.append(f"{recap['turns']} turns")
	if ses.get("model"):
		try:
			model = json.loads(ses["model"])
			stats.append(f"{model.get('id', '?')}#{model.get('variant', '')}" if model.get("variant") else model.get("id", "?"))
		except Exception:
			pass
	tok_in = ses.get("tokens_in") or 0
	tok_out = ses.get("tokens_out") or 0
	if tok_in or tok_out:
		stats.append(f"{(tok_in + tok_out) / 1000:.1f}K tok")
	cost = ses.get("cost") or 0.0
	if cost:
		stats.append(f"${cost:.2f}")
	stats.append(f"last active {_format_ts(ses.get('updated_ms') or 0)}")
	lines.append(f"  \033[1;34m{'Activity:':<13}\033[0m {' · '.join(stats)}")

	if recap.get("first_user"):
		lines.extend(_wrap_field("First Prompt:", recap["first_user"]))
	if recap.get("last_user") and recap["last_user"] != recap["first_user"]:
		lines.extend(_wrap_field("Last Prompt:", recap["last_user"]))
	if recap.get("last_agent"):
		lines.extend(_wrap_field("Last Answer:", recap["last_agent"]))

	resume = f"opencode --session {ses['id']}" if ses.get("id") else "opencode"
	if ses and not ses.get("certain"):
		resume += "   (attributed — check the title)"
	lines.append(f"  \033[1;34m{'Resume:':<13}\033[0m \033[32m{resume}\033[0m")
	lines.append(rule)
	lines.append("")
	try:
		with open(tty, "w", encoding="utf-8", errors="replace") as tf:
			tf.write("\r\n".join(lines) + "\r\n")
	except OSError:
		return

	# The cursor now sits below the recap while the shell prompt above is stale.
	# A fresh Enter re-prompts; cmux send-key is the only portable injection
	# available (TIOCSTI is denied on macOS). Best-effort, cmux-optional.
	if surface_id:
		cmux_bin = resolve_cmux_bin()
		if cmux_bin:
			cmd = [cmux_bin]
			if socket_path:
				cmd.extend(["--socket", socket_path])
			cmd.extend(["send-key", "--surface", surface_id, "enter"])
			try:
				subprocess.run(cmd, capture_output=True, text=True, timeout=5)
			except Exception:
				pass


def cmd_status(args: argparse.Namespace) -> int:
	procs = get_live_processes()
	if not procs:
		if args.json:
			print(json.dumps({"captured_at": _format_ts(_now_ms()), "sessions": []}))
			return 0
		print("No live opencode TUI sessions found.")
		return 0
	cur = db_readonly()
	if not cur:
		print(f"OpenCode DB not found at {DB_PATH}")
		return 1
	attribute_sessions(cur, procs)
	now_ms = _now_ms()
	rows = []
	for proc in procs:
		ses = proc.get("session") or {}
		conv_hr = (
			(now_ms - ses.get("updated_ms", now_ms)) / 3_600_000 if ses else float("inf")
		)
		proc_hr = proc["elapsed_sec"] / 3600 if proc["elapsed_sec"] != float("inf") else float("inf")
		tty_hr = get_tty_idle_sec(proc["tty"]) / 3600
		eff = min(conv_hr, proc_hr)
		in_use = tty_hr * 3600 < getattr(args, "tty_grace_min", 15.0) * 60
		rows.append({
			"pid": proc["pid"],
			"tty": proc["tty"],
			"cwd": proc["cwd"],
			"argv_sid": proc["argv_sid"],
			"session_id": ses.get("id", ""),
			"session_title": ses.get("title", ""),
			"certain": bool(ses.get("certain")),
			"conv_idle_hr": round(conv_hr, 2),
			"proc_idle_hr": round(proc_hr, 2),
			"tty_idle_hr": round(tty_hr, 2),
			"eff_idle_hr": round(eff, 2),
			"in_use": in_use,
		})
	if args.json:
		print(json.dumps({"captured_at": _format_ts(_now_ms()), "sessions": rows}, indent=2))
	else:
		print(f"{'PID':<7} | {'Conv':<9} | {'Proc':<9} | {'TTY':<9} | {'Eff':<9} | Session")
		print("-" * 84)
		for row in rows:
			label = row["session_title"] or row["session_id"] or "?"
			if not row["certain"] and row["session_id"]:
				label += " (?)"
			if row["in_use"]:
				label += " [in-use]"
			print(
				f"{row['pid']:<7} | {row['conv_idle_hr']:5.1f}h | {row['proc_idle_hr']:5.1f}h | {row['tty_idle_hr']:5.1f}h | {row['eff_idle_hr']:5.1f}h | {label}"
			)
	cur.close()
	return 0


def cmd_cull(args: argparse.Namespace) -> int:
	procs = get_live_processes()
	if args.pid:
		procs = [p for p in procs if p["pid"] == args.pid]
	if not procs:
		if not args.quiet:
			print("No live opencode TUI sessions found.")
		return 0
	cur = db_readonly()
	if not cur:
		if not args.quiet:
			print(f"OpenCode DB not found at {DB_PATH}")
		return 1
	attribute_sessions(cur, procs)

	now_ms = _now_ms()
	threshold_sec = args.hours * 3600.0
	grace_sec = args.tty_grace_min * 60.0
	candidates = []
	stats = []
	seen_sessions: set[str] = set()
	for proc in procs:
		ses = proc.get("session") or {}
		conv_sec = (now_ms - ses["updated_ms"]) / 1000 if ses.get("updated_ms") else float("inf")
		proc_sec = proc["elapsed_sec"]
		tty_sec = get_tty_idle_sec(proc["tty"])
		# TTY mtime measures the last write to the terminal — including
		# SIGWINCH redraws and focus events fired by any layout change in
		# cmux (opening/closing/switching tabs). It cannot distinguish
		# "user is in this tab" from "user touched the app elsewhere", so it
		# is a short in-use grace, not a full-threshold gate: a tab counts
		# as idle once conv+proc are idle AND nobody wrote to it recently.
		idle_sec = min(conv_sec, proc_sec)
		idle_hr = idle_sec / 3600
		in_use = tty_sec < grace_sec
		stats.append((proc, conv_sec / 3600, proc_sec / 3600, tty_sec / 3600, idle_hr, in_use))
		# Never cull two TUIs attributed to the same session.
		if ses.get("id") and ses["id"] in seen_sessions:
			continue
		if idle_sec >= threshold_sec and not in_use:
			if ses.get("id"):
				seen_sessions.add(ses["id"])
			candidates.append((proc, idle_hr))

	if args.verbose and not args.quiet:
		print(f"{'PID':<7} | {'Conv':<9} | {'Proc':<9} | {'TTY':<9} | {'Eff':<9} | Session")
		print("-" * 84)
		for proc, c_hr, p_hr, t_hr, e_hr, in_use in stats:
			ses = proc.get("session") or {}
			label = ses.get("title") or ses.get("id", "?")
			if ses and not ses.get("certain"):
				label += " (?)"
			if in_use:
				label += " [in-use]"
			print(
				f"{proc['pid']:<7} | {c_hr:5.1f}h | {p_hr:5.1f}h | {t_hr:5.1f}h | {e_hr:5.1f}h | {label}"
			)
		print()

	if not candidates:
		cur.close()
		if not args.quiet:
			print(f"No idle opencode sessions exceeding {args.hours:g}h (scanned {len(procs)} live TUIs).")
		return 0

	print(f"Found {len(candidates)} session(s) idle for > {args.hours:g}h {'[DRY-RUN]' if args.dry_run else ''}:")
	culled = []
	for proc, idle_hr in candidates:
		ses = proc.get("session") or {}
		title_disp = f"'{ses.get('title')}'" if ses.get("title") else ses.get("id", "?")
		if args.dry_run:
			print(f"  [DRY-RUN] Would cull PID {proc['pid']} (idle {idle_hr:.1f}h): {title_disp}")
			continue
		proc["surface_id"], proc["socket_path"] = get_cmux_env(proc["pid"])
		method = graceful_exit_opencode(proc["pid"], proc["tty"])
		print(f"  \033[1;33m[CULLED]\033[0m Closed idle opencode (PID {proc['pid']}, idle {idle_hr:.1f}h, via {method}): {title_disp}")
		culled.append((proc, idle_hr))

	if not args.dry_run and culled:
		time.sleep(0.5)
		for proc, idle_hr in culled:
			recap = get_recap(cur, (proc.get("session") or {}).get("id", ""))
			write_tty_recap(
				proc["tty"],
				proc,
				idle_hr,
				recap,
				proc.get("surface_id", ""),
				proc.get("socket_path", ""),
			)
		if not args.quiet:
			print(f"\nSuccessfully culled {len(culled)} idle session(s). Tabs remain open with resume command ready.")
	cur.close()
	return 0


def build_parser() -> argparse.ArgumentParser:
	parser = argparse.ArgumentParser(
		prog="opencode-sessions",
		description="Inspect and gracefully cull idle OpenCode TUI sessions in any terminal.",
	)
	sub = parser.add_subparsers(dest="subcommand", required=True)

	p_status = sub.add_parser("status", help="Show live opencode TUIs with idle breakdown")
	p_status.add_argument("--json", action="store_true", help="Emit machine-readable JSON")
	p_status.add_argument(
		"--tty-grace-min",
		type=float,
		default=15.0,
		help="Mark tabs with tty activity within this many minutes as in-use (default: 15)",
	)
	p_status.add_argument("-q", "--quiet", action="store_true", help="Suppress output")
	p_status.set_defaults(func=cmd_status)

	p_cull = sub.add_parser("cull", help="Gracefully close opencode TUIs idle for more than --hours")
	p_cull.add_argument("--hours", type=float, default=2.0, help="Idle hour threshold to trigger culling (default: 2)")
	p_cull.add_argument(
		"--tty-grace-min",
		type=float,
		default=15.0,
		help="Protect tabs with tty activity within this many minutes (default: 15)",
	)
	p_cull.add_argument("--pid", type=int, help="Only consider this TUI process (for targeted culls)")
	p_cull.add_argument("-n", "--dry-run", action="store_true", help="Preview which sessions would be culled")
	p_cull.add_argument("-v", "--verbose", action="store_true", help="Show the idle breakdown for every live session")
	p_cull.add_argument("-q", "--quiet", action="store_true", help="Suppress output")
	p_cull.set_defaults(func=cmd_cull)

	return parser


def main() -> int:
	parser = build_parser()
	args = parser.parse_args()
	return args.func(args)


if __name__ == "__main__":
	sys.exit(main())
