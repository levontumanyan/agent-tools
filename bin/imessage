#!/usr/bin/env python3
import sys
import os
import sqlite3
import argparse
import datetime
import csv
import re

import json

# Apple Core Data epoch starts on Jan 1, 2001
APPLE_EPOCH_OFFSET = 978307200

def get_db_path():
	return os.path.expanduser("~/Library/Messages/chat.db")

def format_size(size_bytes):
	if not size_bytes:
		return "0 B"
	if size_bytes < 1024:
		return f"{size_bytes} B"
	elif size_bytes < 1024 * 1024:
		return f"{size_bytes / 1024:.1f} KB"
	else:
		return f"{size_bytes / (1024 * 1024):.1f} MB"

def decode_attributed_body(data):
	if not data:
		return ""
	try:
		# Search for NSString/NSMutableString class reference in binary plist/typedstream
		ns_idx = data.find(b'NSString')
		if ns_idx == -1:
			ns_idx = data.find(b'NSMutableString')

		if ns_idx != -1:
			# Look for the '+' (0x2b) character indicating object string data in NeXT/Apple serialization
			start_search = ns_idx + 8
			star_idx = data.find(b'+', start_search)

			if star_idx != -1:
				len_byte = data[star_idx + 1]
				offset = 2
				# Handle variable length integer encoding
				if len_byte & 0x80:
					length = len_byte & 0x7f
					shift = 7
					while True:
						next_byte = data[star_idx + offset]
						length |= (next_byte & 0x7f) << shift
						offset += 1
						shift += 7
						if not (next_byte & 0x80):
							break
				else:
					length = len_byte

				str_start = star_idx + offset
				str_bytes = data[str_start : str_start + length]
				text = str_bytes.decode('utf-8', errors='ignore')
				text = re.split(r'i?I?NSDictionary|__kIM', text)[0]
				text = re.sub(r'[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]', '', text)
				return text.strip().rstrip('iI').strip()

		# Fallback to splitting by NSString if direct parse fails
		decoded = data.decode('utf-8', errors='replace')
		if "NSString" in decoded:
			parts = decoded.split("NSString")
			candidate = parts[-1]
			# Strip non-printable binary characters
			candidate = candidate.lstrip('\x00\x01\x02\x03\x04\x05\x06\x07\x08\t\r\n ')
			candidate = re.split(r'i?I?NSDictionary|__kIM', candidate)[0]
			candidate = re.sub(r'[\x00-\x08\x0b\x0c\x0e-\x1f\x7f-\x9f]', '', candidate)
			return candidate.strip().rstrip('iI').strip()
		return decoded
	except Exception:
		try:
			return "".join(c for c in data.decode('utf-8', errors='replace') if c.isprintable() or c in "\n\r\t")
		except Exception:
			return ""

def format_date(date_raw):
	if date_raw is None:
		return ""
	if date_raw > 100000000000000:
		seconds = date_raw / 1000000000
	else:
		seconds = date_raw
	try:
		date_obj = datetime.datetime.fromtimestamp(seconds + APPLE_EPOCH_OFFSET)
		return date_obj.strftime("%Y-%m-%d %H:%M:%S")
	except Exception:
		return ""

def search_messages(query=None, contact=None, days=None, limit=50, csv_output=False, show_chat=None, attachments_only=False):
	db_path = get_db_path()
	if not os.path.exists(db_path):
		print("Error: iMessage database chat.db not found.", file=sys.stderr)
		sys.exit(1)

	try:
		conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
		cursor = conn.cursor()
	except sqlite3.OperationalError:
		print("Error: Unable to open iMessage database.", file=sys.stderr)
		print("Please ensure your Terminal or IDE has 'Full Disk Access' enabled under:", file=sys.stderr)
		print("System Settings > Privacy & Security > Full Disk Access", file=sys.stderr)
		sys.exit(1)

	sql = """
		SELECT
			m.ROWID,
			m.date,
			m.text,
			m.attributedBody,
			h.id AS sender,
			m.is_from_me,
			c.display_name AS chat_name,
			c.chat_identifier,
			json_group_array(
				json_object(
					'filename', a.filename,
					'mime_type', a.mime_type,
					'transfer_name', a.transfer_name,
					'total_bytes', a.total_bytes
				)
			) FILTER (WHERE a.ROWID IS NOT NULL) AS attachments
		FROM message m
		LEFT JOIN handle h ON m.handle_id = h.ROWID
		LEFT JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
		LEFT JOIN chat c ON cmj.chat_id = c.ROWID
		LEFT JOIN message_attachment_join maj ON m.ROWID = maj.message_id
		LEFT JOIN attachment a ON maj.attachment_id = a.ROWID
	"""

	conditions = []
	params = []

	if attachments_only:
		conditions.append("m.ROWID IN (SELECT message_id FROM message_attachment_join)")

	if days is not None and days > 0:
		cutoff_date = datetime.datetime.now() - datetime.timedelta(days=days)
		cutoff_apple_epoch = int(cutoff_date.timestamp() - APPLE_EPOCH_OFFSET)
		conditions.append("(m.date >= ? OR m.date >= ?)")
		params.extend([cutoff_apple_epoch, cutoff_apple_epoch * 1000000000])

	if contact:
		conditions.append("(h.id LIKE ? OR c.display_name LIKE ? OR c.chat_identifier LIKE ?)")
		like_contact = f"%{contact}%"
		params.extend([like_contact, like_contact, like_contact])

	if show_chat:
		conditions.append("(c.display_name = ? OR c.chat_identifier = ? OR h.id = ?)")
		params.extend([show_chat, show_chat, show_chat])

	if conditions:
		sql += " WHERE " + " AND ".join(conditions)

	sql += " GROUP BY m.ROWID ORDER BY m.date DESC"

	try:
		cursor.execute(sql, params)
		rows = cursor.fetchall()
	except sqlite3.Error as e:
		print(f"Error executing database query: {e}", file=sys.stderr)
		conn.close()
		sys.exit(1)

	# Fallback contact search: if direct contact handle/chat lookup returned 0 rows,
	# scan all message bodies/blobs for contact name to resolve associated handles
	if not rows and contact:
		sql_all = """
			SELECT
				m.ROWID,
				m.date,
				m.text,
				m.attributedBody,
				h.id AS sender,
				m.is_from_me,
				c.display_name AS chat_name,
				c.chat_identifier,
				json_group_array(
					json_object(
						'filename', a.filename,
						'mime_type', a.mime_type,
						'transfer_name', a.transfer_name,
						'total_bytes', a.total_bytes
					)
				) FILTER (WHERE a.ROWID IS NOT NULL) AS attachments
			FROM message m
			LEFT JOIN handle h ON m.handle_id = h.ROWID
			LEFT JOIN chat_message_join cmj ON m.ROWID = cmj.message_id
			LEFT JOIN chat c ON cmj.chat_id = c.ROWID
			LEFT JOIN message_attachment_join maj ON m.ROWID = maj.message_id
			LEFT JOIN attachment a ON maj.attachment_id = a.ROWID
		"""
		fallback_conditions = []
		fallback_params = []
		if attachments_only:
			fallback_conditions.append("m.ROWID IN (SELECT message_id FROM message_attachment_join)")
		if days is not None and days > 0:
			cutoff_date = datetime.datetime.now() - datetime.timedelta(days=days)
			cutoff_apple_epoch = int(cutoff_date.timestamp() - APPLE_EPOCH_OFFSET)
			fallback_conditions.append("(m.date >= ? OR m.date >= ?)")
			fallback_params.extend([cutoff_apple_epoch, cutoff_apple_epoch * 1000000000])
		if fallback_conditions:
			sql_all += " WHERE " + " AND ".join(fallback_conditions)
		sql_all += " GROUP BY m.ROWID ORDER BY m.date DESC"
		cursor.execute(sql_all, fallback_params)

		all_rows = cursor.fetchall()
		contact_bytes = contact.encode("utf-8").lower()
		matched_handles = set()
		for r in all_rows:
			txt = r[2] or ""
			blob = r[3]
			if contact.lower() in txt.lower() or (blob and contact_bytes in blob.lower()):
				if r[4]: matched_handles.add(r[4])
				if r[7]: matched_handles.add(r[7])

		if matched_handles:
			rows = [r for r in all_rows if (r[4] in matched_handles or r[7] in matched_handles)]

	if not rows:
		print("No messages found matching the criteria.")
		conn.close()
		return

	# Post-process rows: decode attributed body and filter by text query if needed
	processed_rows = []
	query_bytes = query.encode("utf-8").lower() if query else None

	for row in rows:
		row_id, date_raw, text, attr_body, sender, is_from_me, chat_name, chat_id, raw_attachments = row

		# Deduplicate attachments (prefer entries with local on-disk filename over iCloud metadata placeholders)
		attachments = []
		if raw_attachments:
			try:
				parsed_atts = json.loads(raw_attachments)
				by_name = {}
				for att in parsed_atts:
					fn = att.get("filename")
					tn = att.get("transfer_name") or (os.path.basename(fn) if fn else "")
					if not tn and not fn:
						continue
					key = tn or fn
					if key in by_name:
						if not by_name[key].get("filename") and fn:
							by_name[key] = att
					else:
						by_name[key] = att
				attachments = list(by_name.values())
			except Exception:
				attachments = []

		if attachments_only and not attachments:
			continue

		body = text
		if not body and attr_body:
			body = decode_attributed_body(attr_body)

		if not body:
			body = ""

		# Clean object replacement character \ufffc
		clean_body = body.replace("\ufffc", "").strip()

		# Query matching against body text OR attachment names/types
		if query:
			q_lower = query.lower()
			body_matches = q_lower in body.lower()
			att_matches = any(
				(q_lower in (a.get("transfer_name") or "").lower()) or
				(q_lower in (a.get("filename") or "").lower()) or
				(q_lower in (a.get("mime_type") or "").lower())
				for a in attachments
			)
			if not (body_matches or att_matches):
				continue

		date_str = format_date(date_raw)
		sender_display = "Me" if is_from_me else (sender or "Unknown")

		if chat_name:
			conv = chat_name
		elif chat_id:
			conv = chat_id
		else:
			conv = sender_display

		processed_rows.append((row_id, date_str, sender_display, conv, clean_body, attachments))
		if limit is not None and limit > 0 and len(processed_rows) >= limit:
			break

	if not processed_rows:
		print("No messages found matching the criteria.")
		conn.close()
		return

	if csv_output:
		writer = csv.writer(sys.stdout)
		writer.writerow(["ID", "Date", "Sender", "Conversation", "Message", "Attachments", "Attachment_Paths"])
		for r in processed_rows:
			att_names = "; ".join(a.get("transfer_name") or "" for a in r[5])
			att_paths = "; ".join(os.path.expanduser(a.get("filename") or "") for a in r[5] if a.get("filename"))
			writer.writerow([r[0], r[1], r[2], r[3], r[4], att_names, att_paths])
	elif attachments_only:
		print(f"\nFound {len(processed_rows)} message(s) with attachment(s):")
		print("=" * 120)
		for row_id, date_str, sender, conv, body, atts in processed_rows:
			print(f"Date:         {date_str}")
			print(f"Sender:       {sender}")
			print(f"Conversation: {conv}")
			if body:
				print(f"Message:      {body}")
			print("Attachments:")
			for a in atts:
				name = a.get("transfer_name") or "Unnamed"
				mime = a.get("mime_type") or "unknown"
				size = format_size(a.get("total_bytes", 0))
				raw_fn = a.get("filename") or ""
				full_path = os.path.expanduser(raw_fn) if raw_fn else "(not cached locally)"
				exists_tag = "" if os.path.exists(full_path) else " [file missing]"
				meta = f" ({size}, {mime})" if size or mime != "unknown" else ""
				print(f"  • {name}{meta}")
				print(f"    Path: {full_path}{exists_tag}")
			print("-" * 120)
	else:
		print(f"\nFound {len(processed_rows)} message(s):")
		print("-" * 120)
		print(f"{'Date':<20} | {'Sender':<25} | {'Conversation':<25} | {'Message'}")
		print("-" * 120)
		for row_id, date_str, sender, conv, body, atts in processed_rows:
			if atts:
				att_names = ", ".join(a.get("transfer_name") or os.path.basename(a.get("filename", "")) for a in atts)
				if body:
					combined = f"{body} [Attachment: {att_names}]"
				else:
					combined = f"[Attachment: {att_names}]"
			else:
				combined = body
			preview = combined.replace("\n", " ").replace("\r", " ")
			if len(preview) > 60:
				preview = preview[:57] + "..."

			print(f"{date_str:<20} | {sender:<25} | {conv:<25} | {preview}")
		print("-" * 120)

	conn.close()

def main():
	parser = argparse.ArgumentParser(description="Search local iMessage messages on macOS")
	parser.add_argument("-q", "--query", help="Search term in message text")
	parser.add_argument("-c", "--contact", help="Search contact name, phone, or email")
	parser.add_argument("-d", "--days", type=int, help="Search back N days")
	parser.add_argument("-l", "--limit", type=int, default=50, help="Limit results (default: 50, use 0 for unlimited)")
	parser.add_argument("-a", "--attachments", action="store_true", help="Filter to messages with attachments and display file paths")
	parser.add_argument("--show", help="Show full conversation with a specific contact/chat")
	parser.add_argument("--csv", action="store_true", help="Output in CSV format")

	args = parser.parse_args()

	search_messages(
		query=args.query,
		contact=args.contact,
		days=args.days,
		limit=args.limit if args.limit > 0 else None,
		csv_output=args.csv,
		show_chat=args.show,
		attachments_only=args.attachments
	)

if __name__ == "__main__":
	main()
