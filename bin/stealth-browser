#!/usr/bin/env -S uv run --script
# /// script
# dependencies = [
# 	"adblock",
# 	"mcp<2",
# 	"patchright",
# ]
# ///
"""FastMCP server providing browser automation tools over CDP / stealth Chromium using patchright."""

import argparse
import asyncio
import datetime
import json
import os
import random
import re
import shutil
import signal
import subprocess
import sys
import time
import urllib.request
from typing import Any, Optional, Union
from adblock import Engine, FilterSet
from mcp.server.fastmcp import FastMCP
from patchright.async_api import Browser, BrowserContext, Page, async_playwright

mcp = FastMCP("stealth-browser")

CDP_PORT = int(os.environ.get("STEALTH_BROWSER_CDP_PORT", os.environ.get("CDP_PORT", "9222")))
CDP_URL = f"http://127.0.0.1:{CDP_PORT}"
PROFILE_DIR = os.path.expanduser(os.environ.get("STEALTH_BROWSER_PROFILE_DIR", "~/.agent-chromium-profile"))
IDLE_TIMEOUT_SECONDS = int(os.environ.get("STEALTH_BROWSER_IDLE_TIMEOUT", "300"))
CHROMIUM_APP_BIN = "/Applications/Chromium.app/Contents/MacOS/Chromium"
DEFAULT_BROWSER_EXECUTABLE = CHROMIUM_APP_BIN if os.path.exists(CHROMIUM_APP_BIN) else None
BROWSER_EXECUTABLE = os.environ.get("STEALTH_BROWSER_EXECUTABLE", DEFAULT_BROWSER_EXECUTABLE)
APPLE_PASSWORDS_EXT = os.path.expanduser(
	"~/Library/Application Support/BraveSoftware/Brave-Browser/Default/Extensions/pejdijmoenmkgeppbflobdenhhabjlaj/3.4.0_0"
)

MEDIA_RESOURCE_TYPES = {"image", "media", "font"}
MEDIA_FILE_EXTENSIONS = (
	".png", ".jpg", ".jpeg", ".webp", ".gif", ".svg",
	".mp4", ".webm", ".ogg", ".woff", ".woff2", ".ttf", ".otf"
)

CACHE_DIR = os.path.expanduser("~/.cache/stealth-browser")
CACHE_FILE = os.path.join(CACHE_DIR, "easyprivacy.txt")
CACHE_BIN_FILE = os.path.join(CACHE_DIR, "easyprivacy.bin")
EASYPRIVACY_URL = "https://easylist.to/easylist/easyprivacy.txt"

_adblock_engine: Optional[Engine] = None
_adblock_initialized: bool = False


def _load_or_build_engine() -> Optional[Engine]:
	"""Load cached binary engine or compile EasyPrivacy into Brave's adblock-rust engine."""
	os.makedirs(CACHE_DIR, exist_ok=True)

	# 1. Fast path: load compiled binary cache (< 20ms)
	if os.path.exists(CACHE_BIN_FILE):
		try:
			if (time.time() - os.path.getmtime(CACHE_BIN_FILE)) < (7 * 86400):
				engine = Engine(filter_set=FilterSet())
				engine.deserialize_from_file(CACHE_BIN_FILE)
				return engine
		except Exception:
			pass

	# 2. Text rule file: load from cache or download fresh
	content = None
	if os.path.exists(CACHE_FILE):
		try:
			if (time.time() - os.path.getmtime(CACHE_FILE)) < (7 * 86400):
				with open(CACHE_FILE, "r", encoding="utf-8") as f:
					content = f.read()
		except Exception:
			content = None

	if not content:
		try:
			req = urllib.request.Request(EASYPRIVACY_URL, headers={"User-Agent": "Mozilla/5.0"})
			with urllib.request.urlopen(req, timeout=5) as resp:
				content = resp.read().decode("utf-8", errors="ignore")
			with open(CACHE_FILE, "w", encoding="utf-8") as f:
				f.write(content)
		except Exception:
			if os.path.exists(CACHE_FILE):
				try:
					with open(CACHE_FILE, "r", encoding="utf-8") as f:
						content = f.read()
				except Exception:
					content = None

	if content:
		try:
			filters = FilterSet()
			filters.add_filter_list(content)
			engine = Engine(filter_set=filters)
			# Serialize compiled binary to disk for instant subsequent startups
			try:
				engine.serialize_to_file(CACHE_BIN_FILE)
			except Exception:
				pass
			return engine
		except Exception:
			pass
	return None


def get_adblock_engine() -> Optional[Engine]:
	global _adblock_engine, _adblock_initialized
	if not _adblock_initialized:
		_adblock_initialized = True
		_adblock_engine = _load_or_build_engine()
	return _adblock_engine


async def _network_route_handler(route, request):
	"""Intercepts network requests: evaluates trackers against EasyPrivacy and blocks media when enabled."""
	handled = False
	try:
		# Service worker requests do not have an associated frame and should not be blocked
		frame = None
		try:
			frame = request.frame
		except Exception:
			frame = None

		url = request.url
		frame_url = frame.url if frame else ""
		res_type = request.resource_type or "other"

		# Adblock tracker check
		engine = get_adblock_engine()
		if engine is not None:
			try:
				if engine.check_network_urls(url, frame_url, res_type).matched:
					handled = True
					await route.abort()
					return
			except Exception:
				pass

		# Media blocking check (fast path)
		page = frame.page if frame else None
		if page and getattr(page, "_media_blocked", False):
			if res_type in MEDIA_RESOURCE_TYPES:
				handled = True
				await route.abort()
				return
			url_clean = url.split("?")[0].lower()
			if url_clean.endswith(MEDIA_FILE_EXTENSIONS):
				handled = True
				await route.abort()
				return

		handled = True
		await route.continue_()
	except Exception:
		if not handled:
			try:
				await route.continue_()
			except Exception:
				pass


class BrowserSessionManager:
	"""Manages dedicated stealth Chromium browser or CDP connection for AI agents."""

	def __init__(self, cdp_url: str):
		self.cdp_url = cdp_url
		self._playwright = None
		self._browser: Optional[Browser] = None
		self._context: Optional[BrowserContext] = None
		self._active_page: Optional[Page] = None
		self._idle_task: Optional[asyncio.Task] = None

	def _touch_activity(self):
		if self._idle_task is not None and not self._idle_task.done():
			self._idle_task.cancel()
		try:
			loop = asyncio.get_running_loop()
			self._idle_task = loop.create_task(self._idle_watchdog())
		except RuntimeError:
			pass

	async def _idle_watchdog(self):
		try:
			await asyncio.sleep(IDLE_TIMEOUT_SECONDS)
			# Do not auto-stop if keep-alive workers are active
			if "keep_alive_mgr" in globals() and keep_alive_mgr.has_active():
				self._touch_activity()
				return
			# Auto-stop the driver on idle if attached via CDP or if no persistent context is open
			if self._browser is not None or self._context is None:
				await self.close()
		except asyncio.CancelledError:
			pass

	async def close(self):
		"""Cleanly stop the patchright node driver and release browser handles."""
		if "keep_alive_mgr" in globals():
			await keep_alive_mgr.stop_all()
		if (
			self._idle_task is not None
			and not self._idle_task.done()
			and asyncio.current_task() is not self._idle_task
		):
			self._idle_task.cancel()
		self._idle_task = None
		self._context = None
		self._browser = None
		self._active_page = None
		if self._playwright is not None:
			try:
				await self._playwright.stop()
			except Exception:
				pass
			finally:
				self.close_sync()

	def close_sync(self):
		"""Synchronously terminate the patchright node driver subprocess if still alive."""
		if self._playwright is None:
			return
		try:
			proc = getattr(self._playwright._impl_obj._connection._transport, "_proc", None)
			if proc is not None and getattr(proc, "pid", None):
				os.kill(proc.pid, signal.SIGTERM)
		except Exception:
			pass
		self._playwright = None

	async def get_context(self) -> BrowserContext:
		self._touch_activity()
		if self._playwright is None:
			self._playwright = await async_playwright().start()

		# Check if an existing context is still alive
		if self._context is not None:
			try:
				if self._browser is not None and not self._browser.is_connected():
					self._browser = None
					self._context = None
				elif hasattr(self._context, "is_closed") and self._context.is_closed():
					self._context = None
				else:
					_ = self._context.pages
					return self._context
			except Exception:
				self._context = None
				self._browser = None

		# 1. Try attaching to existing CDP session (e.g., if launched on port 9222)
		try:
			self._browser = await self._playwright.chromium.connect_over_cdp(
				self.cdp_url,
				timeout=1500,
			)
			if self._browser.contexts:
				self._context = self._browser.contexts[0]
				await self._ensure_interceptor(self._context)
				return self._context
		except Exception:
			self._browser = None

		# 2. Launch dedicated standalone stealth Chromium with CDP remote debugging port enabled
		os.makedirs(PROFILE_DIR, exist_ok=True)

		# Ensure Apple Passwords native messaging manifest exists in agent profile
		nm_hosts_dir = os.path.join(PROFILE_DIR, "NativeMessagingHosts")
		os.makedirs(nm_hosts_dir, exist_ok=True)
		nm_manifest = os.path.join(nm_hosts_dir, "com.apple.passwordmanager.json")
		system_manifest = "/Library/Google/Chrome/NativeMessagingHosts/com.apple.passwordmanager.json"
		if not os.path.exists(nm_manifest) and os.path.exists(system_manifest):
			shutil.copy2(system_manifest, nm_manifest)

		browser_args = [
			f"--remote-debugging-port={CDP_PORT}",
		]
		if os.path.exists(APPLE_PASSWORDS_EXT):
			browser_args.extend([
				f"--disable-extensions-except={APPLE_PASSWORDS_EXT}",
				f"--load-extension={APPLE_PASSWORDS_EXT}",
			])

		try:
			self._context = await self._playwright.chromium.launch_persistent_context(
				user_data_dir=PROFILE_DIR,
				executable_path=BROWSER_EXECUTABLE,
				headless=False,
				no_viewport=True,
				args=browser_args,
				ignore_default_args=["--no-sandbox"],
			)
		except Exception as exc:
			if "Opening in existing browser session" in str(exc) or "already in use" in str(exc):
				# The browser might be in the middle of launching; retry connecting over CDP
				for _ in range(3):
					await asyncio.sleep(0.5)
					try:
						self._browser = await self._playwright.chromium.connect_over_cdp(
							self.cdp_url,
							timeout=1500,
						)
						if self._browser.contexts:
							self._context = self._browser.contexts[0]
							await self._ensure_interceptor(self._context)
							return self._context
					except Exception:
						pass

				fallback_dir = f"{PROFILE_DIR}-{os.getpid()}"
				os.makedirs(fallback_dir, exist_ok=True)
				self._context = await self._playwright.chromium.launch_persistent_context(
					user_data_dir=fallback_dir,
					executable_path=BROWSER_EXECUTABLE,
					headless=False,
					no_viewport=True,
					ignore_default_args=["--no-sandbox"],
				)
			else:
				raise
		await self._ensure_interceptor(self._context)
		return self._context

	async def _ensure_interceptor(self, context: BrowserContext):
		if getattr(context, "_interceptor_attached", False):
			return
		setattr(context, "_interceptor_attached", True)
		try:
			await context.route("**/*", _network_route_handler)
		except Exception:
			pass

	def _register_page_listeners(self, page: Page):
		"""Attach lifecycle event listeners to auto-invalidate cached pointer on tab close or renderer crash."""
		if getattr(page, "_agent_listeners_attached", False):
			return
		setattr(page, "_agent_listeners_attached", True)

		def _on_closed_or_crashed(_=None):
			if self._active_page is page:
				self._active_page = None

		page.on("close", _on_closed_or_crashed)
		page.on("crash", _on_closed_or_crashed)

	def set_active_page(self, page: Page):
		self._active_page = page
		if page is not None and not page.is_closed():
			self._register_page_listeners(page)

	async def get_pages(self) -> list[Page]:
		context = await self.get_context()
		return [p for p in context.pages if not p.is_closed()]

	async def get_active_page(self) -> Page:
		self._touch_activity()
		if (
			self._active_page is not None
			and not self._active_page.is_closed()
			and (self._browser is None or self._browser.is_connected())
		):
			return self._active_page

		try:
			context = await self.get_context()
			pages = await self.get_pages()
			# Check for an existing empty/blank tab to avoid tab proliferation
			blank_pages = [p for p in pages if p.url in ("about:blank", "chrome://newtab/", "")]
			if blank_pages:
				page = blank_pages[0]
			elif pages:
				page = pages[-1]
			else:
				page = await context.new_page()

			self.set_active_page(page)
			return page
		except Exception as exc:
			if "closed" in str(exc).lower():
				# Browser window was killed externally; reset and relaunch
				await self.close()
				context = await self.get_context()
				pages = await self.get_pages()
				blank_pages = [p for p in pages if p.url in ("about:blank", "chrome://newtab/", "")]
				if blank_pages:
					page = blank_pages[0]
				elif pages:
					page = pages[-1]
				else:
					page = await context.new_page()
				self.set_active_page(page)
				return page
			raise

	async def resolve_page(self, tab: int = -1) -> Page:
		self._touch_activity()
		if tab < 0:
			# Fast path: instant in-memory pointer resolution (< 0.01ms)
			if (
				self._active_page is not None
				and not self._active_page.is_closed()
				and (self._browser is None or self._browser.is_connected())
			):
				return self._active_page
			return await self.get_active_page()

		# Explicit tab index requested
		pages = await self.get_pages()
		if tab >= len(pages):
			raise ValueError(f"Invalid tab index {tab}. Total open tabs: {len(pages)}")
		return pages[tab]


session = BrowserSessionManager(CDP_URL)


class KeepAliveManager:
	"""Manages background jittered keep-alive workers to prevent web session timeouts."""

	def __init__(self):
		self._tasks: dict[Page, asyncio.Task] = {}
		self._configs: dict[Page, dict] = {}

	def has_active(self) -> bool:
		self._cleanup_dead_tasks()
		return bool(self._tasks)

	def _cleanup_dead_tasks(self):
		dead = [p for p, t in self._tasks.items() if p.is_closed() or t.done()]
		for p in dead:
			self._tasks.pop(p, None)
			self._configs.pop(p, None)

	def is_active(self, page: Page) -> bool:
		task = self._tasks.get(page)
		return task is not None and not task.done() and not page.is_closed()

	def get_config(self, page: Page) -> Optional[dict]:
		return self._configs.get(page)

	async def stop(self, page: Page):
		task = self._tasks.pop(page, None)
		self._configs.pop(page, None)
		if task is not None and not task.done():
			task.cancel()
			try:
				await task
			except asyncio.CancelledError:
				pass

	async def stop_all(self):
		tasks = list(self._tasks.values())
		self._tasks.clear()
		self._configs.clear()
		for t in tasks:
			if not t.done():
				t.cancel()
		if tasks:
			await asyncio.gather(*tasks, return_exceptions=True)

	async def start(
		self,
		page: Page,
		min_seconds: int = 45,
		max_seconds: int = 90,
		ping_url: Optional[str] = None,
	):
		await self.stop(page)
		self._configs[page] = {
			"min_seconds": min_seconds,
			"max_seconds": max_seconds,
			"ping_url": ping_url,
			"started_at": datetime.datetime.now().isoformat(),
			"last_ping": None,
		}

		async def _worker():
			try:
				while not page.is_closed():
					delay = random.uniform(float(min_seconds), float(max_seconds))
					await asyncio.sleep(delay)
					if page.is_closed():
						break

					session._touch_activity()

					js_keep_alive = """async (pingUrl) => {
						const buttons = Array.from(document.querySelectorAll('button, a, [role="button"]'));
						const keepWorking = buttons.find(b => {
							const t = (b.innerText || '').toLowerCase();
							return t.includes('keep working') || t.includes('continue session') || t.includes('stay signed in') || t.includes('extend session');
						});
						let clicked = false;
						if (keepWorking) {
							try { keepWorking.click(); clicked = true; } catch (e) {}
						}

						const x = Math.floor(Math.random() * 500) + 100;
						const y = Math.floor(Math.random() * 400) + 100;
						window.dispatchEvent(new MouseEvent('mousemove', { clientX: x, clientY: y, bubbles: true }));
						window.dispatchEvent(new Event('scroll', { bubbles: true }));

						let pingStatus = null;
						if (pingUrl) {
							try {
								const res = await fetch(pingUrl);
								pingStatus = res.status;
							} catch (e) {
								pingStatus = e.message;
							}
						}
						return { clicked, pingStatus, x, y };
					}"""
					try:
						res = await page.evaluate(js_keep_alive, ping_url)
						if page in self._configs:
							self._configs[page]["last_ping"] = {
								"timestamp": datetime.datetime.now().isoformat(),
								"details": res,
							}
					except Exception:
						pass
			except asyncio.CancelledError:
				pass
			finally:
				self._tasks.pop(page, None)
				self._configs.pop(page, None)

		task = asyncio.create_task(_worker())
		self._tasks[page] = task


keep_alive_mgr = KeepAliveManager()

async def set_page_media_state(page: Page, block_media: bool):
	"""Enable or disable media blocking on a given page."""
	setattr(page, "_media_blocked", block_media)


@mcp.tool()
async def status() -> str:
	"""Check connection status to Stealth Browser and list all open tabs."""
	try:
		pages = await session.get_pages()
		active_page = session._active_page if (session._active_page is not None and not session._active_page.is_closed()) else None
		lines = [f"Connected to browser session at {CDP_URL}"]
		lines.append(f"Total open tabs: {len(pages)}")
		for idx, page in enumerate(pages):
			active_marker = " (ACTIVE in this session)" if page == active_page else ""
			media_status = " [TEXT-ONLY/MEDIA BLOCKED]" if getattr(page, "_media_blocked", False) else ""
			keep_alive_status = " [KEEP-ALIVE ACTIVE]" if keep_alive_mgr.is_active(page) else ""
			try:
				title = await asyncio.wait_for(page.title(), timeout=2.0)
			except Exception:
				title = "(Unresponsive / Busy)"
			lines.append(f"\t[{idx}] {title} - {page.url}{media_status}{keep_alive_status}{active_marker}")
		return "\n".join(lines)
	except Exception as exc:
		return f"Disconnected: {exc}"


@mcp.tool()
async def keep_alive(
	enable: bool = True,
	tab: int = -1,
	min_seconds: int = 45,
	max_seconds: int = 90,
	ping_url: Optional[str] = None,
) -> str:
	"""Keep a web session alive with randomized jitter intervals and automatic modal dismissal.

	Runs a background worker for the tab that:
	- Periodically dispatches randomized human-like mouse movements and scroll events.
	- Detects and automatically clicks common session-timeout dialogs (e.g. 'Keep Working', 'Stay Signed In').
	- Optionally pings a specified session heartbeat endpoint with HTTP requests.
	- Prevents the stealth-browser MCP driver from shutting down on idle.

	Parameters:
	- enable: Set to True to activate keep-alive on the tab; False to disable.
	- tab: Target tab index (-1 for active tab).
	- min_seconds: Minimum randomized interval between heartbeats (default 45).
	- max_seconds: Maximum randomized interval between heartbeats (default 90).
	- ping_url: Optional relative or absolute URL to fetch periodically for server-side token refresh.
	"""
	try:
		page = await session.resolve_page(tab)
		pages = await session.get_pages()
		target_index = pages.index(page) if page in pages else tab

		if not enable:
			await keep_alive_mgr.stop(page)
			return f"Disabled keep-alive on tab [{target_index}] ({page.url})"

		await keep_alive_mgr.start(
			page=page,
			min_seconds=min_seconds,
			max_seconds=max_seconds,
			ping_url=ping_url,
		)
		ping_info = f", pinging '{ping_url}'" if ping_url else ""
		return (
			f"Activated keep-alive on tab [{target_index}] ({page.url}): "
			f"jitter interval {min_seconds}-{max_seconds}s, auto-dismiss modals enabled{ping_info}."
		)
	except Exception as exc:
		return f"Error managing keep-alive: {exc}"


@mcp.tool()
async def navigate(
	url: str,
	block_media: Optional[bool] = None,
	new_tab: bool = False,
	tab: int = -1,
	timeout_ms: int = 30000,
	wait_until: str = "domcontentloaded",
) -> str:
	"""Navigate a browser tab to a specific URL with optional media blocking and fast execution.

	Parameters:
	- url: Destination web address (http, https, or about:).
	- block_media: Optional boolean. If True, blocks heavy media (images, videos, custom web fonts) for maximum loading speed (up to 3x faster). If False, enables media loading. If omitted (None), preserves current tab media state.
	- new_tab: If True, opens in a brand new tab.
	- tab: Target tab index (-1 for active tab).
	- timeout_ms: Maximum navigation timeout in milliseconds (default 30000).
	- wait_until: Navigation wait condition: 'domcontentloaded' for mounted DOM (default), 'commit' for ultra-fast response headers, or 'load'/'networkidle'.
	"""
	t0 = time.perf_counter()
	try:
		context = await session.get_context()
		if new_tab:
			pages = await session.get_pages()
			blank_pages = [p for p in pages if p.url in ("about:blank", "chrome://newtab/", "")]
			if blank_pages:
				page = blank_pages[0]
			else:
				page = await context.new_page()
			session.set_active_page(page)
		else:
			page = await session.resolve_page(tab)

		# Apply media blocking state if explicitly specified
		if block_media is not None:
			await set_page_media_state(page, block_media=block_media)

		# Ensure URL has protocol
		if not url.startswith("http://") and not url.startswith("https://") and not url.startswith("about:"):
			url = "https://" + url

		valid_waits = {"commit", "domcontentloaded", "load", "networkidle"}
		wait_mode = wait_until if wait_until in valid_waits else "domcontentloaded"

		response = await page.goto(url, timeout=timeout_ms, wait_until=wait_mode)
		status = response.status if response else "loaded"
		title = await page.title()
		pages = await session.get_pages()
		target_idx = pages.index(page) if page in pages else -1
		elapsed = int((time.perf_counter() - t0) * 1000)
		is_media_blocked = getattr(page, "_media_blocked", False)
		media_tag = " (media blocked)" if is_media_blocked else ""
		return f"Navigated tab [{target_idx}] to '{url}' [HTTP {status}]{media_tag} ({elapsed}ms, wait_until={wait_mode}) - Title: '{title}'"
	except Exception as exc:
		return f"Navigation error: {exc}"


@mcp.tool()
async def new_tab(url: str = "about:blank", block_media: Optional[bool] = None) -> str:
	"""Open a new browser tab and navigate to url (default 'about:blank'). Set block_media=True for high-speed text-only browsing."""
	return await navigate(url=url, block_media=block_media, new_tab=True)


@mcp.tool()
async def set_media(enable_media: bool = True, tab: int = -1) -> str:
	"""Toggle media loading (images, videos, web fonts) on the current or specified tab.

	Parameters:
	- enable_media: Set to True (default) to allow full image and media loading. Set to False to block images and fonts for blazing-fast text-only scraping.
	- tab: Target tab index (-1 for active tab).
	"""
	try:
		page = await session.resolve_page(tab)
		await set_page_media_state(page, block_media=not enable_media)
		pages = await session.get_pages()
		target_idx = pages.index(page) if page in pages else -1
		state_str = "ENABLED (images, charts, and media will load)" if enable_media else "BLOCKED (high-speed text-only mode)"
		return f"Media loading is now {state_str} on tab [{target_idx}] ({page.url})"
	except Exception as exc:
		return f"Error updating media state: {exc}"


@mcp.tool()
async def snapshot(selector: str = "body", max_elements: int = 80, tab: int = -1) -> str:
	"""Extract interactive elements (buttons, inputs, links, selects, dropdowns) with exact selectors and values in a single high-speed call."""
	t0 = time.perf_counter()
	try:
		page = await session.resolve_page(tab)
		js_code = """({ targetSelector }) => {
			const isVisible = (el) => {
				const style = window.getComputedStyle(el);
				return style && style.visibility !== 'hidden' && style.display !== 'none' && el.offsetWidth > 0 && el.offsetHeight > 0;
			};
			const root = (targetSelector && targetSelector !== 'body') ? (document.querySelector(targetSelector) || document) : document;
			const nodes = Array.from(root.querySelectorAll(
				'button, input, select, textarea, a[href], [role="button"], [role="combobox"], [role="option"], [role="tab"], [role="menuitem"]'
			)).filter(isVisible);

			return nodes.slice(0, 100).map((el, i) => {
				const tag = el.tagName.toLowerCase();
				const id = el.id ? `#${el.id}` : '';
				const name = el.name ? `[name="${el.name}"]` : '';
				const type = el.type ? `[type="${el.type}"]` : '';
				const role = el.getAttribute('role') ? `[role="${el.getAttribute('role')}"]` : '';
				const aria = el.getAttribute('aria-label') ? `aria-label="${el.getAttribute('aria-label')}"` : '';
				const val = el.value !== undefined && el.value !== '' ? `val="${el.value}"` : '';
				const text = (el.innerText || el.textContent || '').trim().replace(/\\s+/g, ' ').slice(0, 60);

				let selector = el.id ? `#${el.id}` : (el.name ? `${tag}[name="${el.name}"]` : (el.getAttribute('data-testid') ? `[data-testid="${el.getAttribute('data-testid')}"]` : ''));
				if (!selector && el.className && typeof el.className === 'string') {
					const firstClass = el.className.split(' ').filter(c => c && !c.includes(':'))[0];
					if (firstClass) selector = `${tag}.${firstClass}`;
				}
				if (!selector) selector = tag;

				return {
					index: i,
					tag,
					selector,
					text,
					attrs: [id, name, type, role, aria, val].filter(Boolean).join(' ')
				};
			});
		}"""
		try:
			elements = await asyncio.wait_for(page.evaluate(js_code, {"targetSelector": selector}), timeout=10.0)
		except asyncio.TimeoutError:
			return f"Error capturing snapshot: Timed out after 10000ms"
		elapsed_ms = int((time.perf_counter() - t0) * 1000)

		if not elements:
			return f"No interactive elements found on {page.url} ({elapsed_ms}ms)"

		elements = elements[:max_elements]
		lines = [f"Interactive elements snapshot for {page.url} ({elapsed_ms}ms, {len(elements)} items):", ""]
		lines.append("| # | Tag | Selector | Text / Details |")
		lines.append("|---|---|---|---|")
		for el in elements:
			desc = f"{el['text']} ({el['attrs']})" if el['attrs'] else el['text']
			lines.append(f"| {el['index']} | `<{el['tag']}>` | `{el['selector']}` | {desc} |")
		return "\n".join(lines)
	except Exception as exc:
		return f"Error capturing snapshot: {exc}"


@mcp.tool()
async def batch(actions: list[dict], tab: int = -1) -> str:
	"""Execute a pipeline of browser actions sequentially in a single turn for maximum speed (10-100x faster than roundtrips).

	Supported action types in the dict:
	- {"action": "click", "selector": "#btn", "timeout_ms": 3000}
	- {"action": "fill", "selector": "#input", "text": "hello", "timeout_ms": 3000}
	- {"action": "type", "selector": "#input", "text": "hello", "press_enter": True, "timeout_ms": 3000}
	- {"action": "select", "selector": "select#country", "value": "CA", "timeout_ms": 3000}
	- {"action": "press", "key": "Enter"}
	- {"action": "wait_for", "selector": ".modal", "timeout_ms": 3000, "state": "visible"}
	- {"action": "sleep", "ms": 500}
	- {"action": "evaluate", "expression": "window.scrollTo(0, 500)"}
	"""
	t0 = time.perf_counter()
	try:
		page = await session.resolve_page(tab)
		results = []
		for idx, item in enumerate(actions):
			act = item.get("action", "").lower()
			timeout = item.get("timeout_ms", 4000)

			if act == "click":
				sel = item.get("selector")
				if not sel:
					results.append(f"[{idx}] click: SKIPPED (missing 'selector')")
					continue
				await page.locator(sel).first.click(timeout=timeout)
				results.append(f"[{idx}] click '{sel}': OK")

			elif act == "fill":
				sel = item.get("selector")
				if not sel:
					results.append(f"[{idx}] fill: SKIPPED (missing 'selector')")
					continue
				text = str(item.get("text") if item.get("text") is not None else item.get("value", ""))
				await page.locator(sel).first.fill(text, timeout=timeout)
				results.append(f"[{idx}] fill '{sel}': OK")

			elif act == "type":
				sel = item.get("selector")
				if not sel:
					results.append(f"[{idx}] type: SKIPPED (missing 'selector')")
					continue
				text = str(item.get("text") if item.get("text") is not None else item.get("value", ""))
				press_enter = item.get("press_enter", False)
				loc = page.locator(sel).first
				await loc.type(text, timeout=timeout)
				if press_enter:
					await loc.press("Enter")
				results.append(f"[{idx}] type '{sel}' ({'with Enter' if press_enter else ''}): OK")

			elif act == "select":
				sel = item.get("selector")
				if not sel:
					results.append(f"[{idx}] select: SKIPPED (missing 'selector')")
					continue
				val = str(item.get("value") if item.get("value") is not None else item.get("text", ""))
				await page.locator(sel).first.select_option(val, timeout=timeout)
				results.append(f"[{idx}] select '{sel}' option '{val}': OK")

			elif act == "press":
				key = item.get("key") or item.get("button", "Enter")
				await page.keyboard.press(key)
				results.append(f"[{idx}] press '{key}': OK")

			elif act == "wait_for":
				sel = item.get("selector")
				if not sel:
					results.append(f"[{idx}] wait_for: SKIPPED (missing 'selector')")
					continue
				state = item.get("state", "visible")
				await page.locator(sel).first.wait_for(state=state, timeout=timeout)
				results.append(f"[{idx}] wait_for '{sel}' ({state}): OK")

			elif act == "sleep":
				ms = item.get("ms") or item.get("duration_ms", 200)
				await asyncio.sleep(ms / 1000.0)
				results.append(f"[{idx}] sleep {ms}ms: OK")

			elif act == "evaluate":
				expr = item.get("expression") or item.get("code") or item.get("js", "")
				res = await asyncio.wait_for(page.evaluate(expr), timeout=timeout / 1000.0)
				results.append(f"[{idx}] evaluate: {res}")

			else:
				results.append(f"[{idx}] Unknown action '{act}': SKIPPED")

		elapsed = int((time.perf_counter() - t0) * 1000)
		return f"Batch completed ({len(results)} steps in {elapsed}ms) on {page.url}:\n" + "\n".join(results)
	except Exception as exc:
		elapsed = int((time.perf_counter() - t0) * 1000)
		return f"Batch failed after {elapsed}ms: {exc}"


@mcp.tool()
async def get_content(
	selector: str = "body",
	max_length: int = 4000,
	interactive_only: bool = False,
	clean: bool = True,
	tab: int = -1,
) -> str:
	"""Extract visible text content or interactive elements from the active tab. Set interactive_only=True for compact semantic elements snapshot, or clean=False for raw text."""
	try:
		if interactive_only:
			return await snapshot(selector=selector, tab=tab)

		page = await session.resolve_page(tab)
		element = page.locator(selector).first
		if await element.count() == 0:
			return f"Element '{selector}' not found on page {page.url}"

		if clean:
			js_clean = """({ sel }) => {
				const el = document.querySelector(sel);
				if (!el) return '';
				const clone = el.cloneNode(true);
				const junk = clone.querySelectorAll(
					'script, style, svg, noscript, nav, header, footer, [role="banner"], [role="navigation"], [aria-hidden="true"], .cookie-banner, .cookie-consent, #cookie-banner, .advertisement, .ad-banner'
				);
				junk.forEach(n => n.remove());
				return (clone.innerText || clone.textContent || '').trim().replace(/\\n{3,}/g, '\\n\\n');
			}"""
			text = await asyncio.wait_for(page.evaluate(js_clean, {"sel": selector}), timeout=10.0)
		else:
			text = await asyncio.wait_for(element.inner_text(), timeout=10.0)

		text = text.strip()
		if len(text) > max_length:
			truncated = text[:max_length]
			return f"[Showing first {max_length} characters of {len(text)}]:\n{truncated}\n... (truncated)"
		return text if text else "(Page element contains no visible text)"
	except Exception as exc:
		return f"Error extracting content: {exc}"


@mcp.tool()
async def click(selector: str, tab: int = -1, timeout_ms: int = 5000) -> str:
	"""Click an element on the active page or specified tab index by CSS selector, text, or XPath."""
	try:
		page = await session.resolve_page(tab)
		locator = page.locator(selector).first
		await locator.click(timeout=timeout_ms)
		return f"Clicked element matching '{selector}' on {page.url}"
	except Exception as exc:
		return f"Error clicking element '{selector}': {exc}"


@mcp.tool()
async def type(selector: str, text: str, clear_first: bool = True, press_enter: bool = False, tab: int = -1, timeout_ms: int = 5000) -> str:
	"""Type text into an input field or textarea on the active page or specified tab index."""
	try:
		page = await session.resolve_page(tab)
		locator = page.locator(selector).first
		if clear_first:
			await locator.fill(text, timeout=timeout_ms)
		else:
			await locator.type(text, timeout=timeout_ms)

		if press_enter:
			await locator.press("Enter")
			return f"Typed text into '{selector}' and pressed Enter"
		return f"Typed text into '{selector}'"
	except Exception as exc:
		return f"Error typing into '{selector}': {exc}"


@mcp.tool()
async def press_key(key: str, tab: int = -1) -> str:
	"""Press a keyboard key on the active page or specified tab index (e.g., 'Enter', 'Tab', 'Escape')."""
	try:
		page = await session.resolve_page(tab)
		await page.keyboard.press(key)
		return f"Pressed key '{key}' on {page.url}"
	except Exception as exc:
		return f"Error pressing key '{key}': {exc}"


@mcp.tool()
async def scroll(direction: str = "down", amount: int = 600, tab: int = -1) -> str:
	"""Scroll the active page or specified tab index up or down (direction: 'up' or 'down', amount in pixels)."""
	try:
		page = await session.resolve_page(tab)
		delta = amount if direction.lower() == "down" else -amount
		await page.mouse.wheel(0, delta)
		return f"Scrolled {direction} by {amount}px"
	except Exception as exc:
		return f"Error scrolling: {exc}"


@mcp.tool()
async def screenshot(save_path: str = "", tab: int = -1) -> str:
	"""Capture a screenshot of the active page view or specified tab index and return the file path."""
	try:
		page = await session.resolve_page(tab)
		if not save_path:
			timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
			save_path = f"/tmp/screenshot_{timestamp}.png"

		await page.screenshot(path=save_path, full_page=False)
		title = await page.title()
		return f"Screenshot saved to: {save_path}\nPage Title: {title}\nURL: {page.url}"
	except Exception as exc:
		return f"Error taking screenshot: {exc}"


@mcp.tool()
async def fetch(
	url: str,
	method: str = "GET",
	headers: Optional[dict] = None,
	body: Optional[Any] = None,
	response_type: str = "auto",
	tab: int = -1,
	timeout_ms: int = 15000,
) -> str:
	"""Execute an in-browser HTTP request in the active tab origin using authenticated cookies and session state.

	Parameters:
	- url: Target URL or endpoint path (can be relative e.g. '/api/accounts' or absolute).
	- method: HTTP method ('GET', 'POST', 'PUT', 'DELETE', etc. Default 'GET').
	- headers: Optional dictionary of HTTP request headers.
	- body: Optional request payload (string, dict, or list; dict/list will be serialized as JSON with Content-Type header).
	- response_type: Expected format: 'auto' (parses JSON if possible, else text), 'json', or 'text'.
	- tab: Target tab index (-1 for active tab).
	"""
	t0 = time.perf_counter()
	try:
		page = await session.resolve_page(tab)

		# Auto-serialize dict/list body to JSON
		if isinstance(body, (dict, list)):
			body = json.dumps(body)
			if headers is None:
				headers = {}
			headers.setdefault("Content-Type", "application/json")
		js_script = """async ({ url, method, headers, body, responseType }) => {
			const options = {
				method: (method || 'GET').toUpperCase(),
				credentials: 'include',
				headers: headers || {}
			};
			if (body && !['GET', 'HEAD'].includes(options.method)) {
				options.body = body;
			}
			const tStart = performance.now();
			try {
				const res = await window.fetch(url, options);
				const duration = Math.round(performance.now() - tStart);
				const resHeaders = {};
				res.headers.forEach((v, k) => { resHeaders[k] = v; });

				const text = await res.text();
				let parsed = null;
				let isJson = false;
				if (responseType === 'json' || responseType === 'auto') {
					try {
						parsed = JSON.parse(text);
						isJson = true;
					} catch (_) {}
				}
				return {
					ok: res.ok,
					status: res.status,
					statusText: res.statusText,
					url: res.url,
					duration,
					headers: resHeaders,
					isJson,
					data: isJson ? parsed : text
				};
			} catch (err) {
				return {
					error: err.toString(),
					duration: Math.round(performance.now() - tStart)
				};
			}
		}"""
		try:
			result = await asyncio.wait_for(
				page.evaluate(js_script, {
					"url": url,
					"method": method,
					"headers": headers or {},
					"body": body,
					"responseType": response_type,
				}),
				timeout=timeout_ms / 1000.0,
			)
		except asyncio.TimeoutError:
			return f"Error executing fetch: Timed out after {timeout_ms}ms"
		elapsed_total = int((time.perf_counter() - t0) * 1000)

		if "error" in result:
			return f"Fetch error ({result.get('duration', elapsed_total)}ms): {result['error']}"

		status_str = f"HTTP {result['status']} {result['statusText']} ({result['duration']}ms)"
		data = result.get("data")
		if result.get("isJson") and data is not None:
			dumped = json.dumps(data, indent=2)
			if len(dumped) > 60000:
				dumped = dumped[:60000] + f"\n... [Truncated: {len(dumped)} total characters]"
			return f"{status_str} [JSON] from {result['url']}:\n\n{dumped}"
		else:
			text = str(data or "")
			if len(text) > 60000:
				text = text[:60000] + f"\n... [Truncated: {len(text)} total characters]"
			return f"{status_str} [TEXT] from {result['url']}:\n\n{text}"
	except Exception as exc:
		return f"Error executing fetch: {exc}"


@mcp.tool()
async def state(
	framework: str = "auto",
	selector: str = "",
	tab: int = -1,
) -> str:
	"""Inspect and extract in-memory client-side application state (Next.js, Redux, React Fiber, Vue, Apollo, React Query).

	Parameters:
	- framework: Target framework to probe ('auto', 'next', 'redux', 'react', 'vue', 'apollo', 'query').
	- selector: Optional DOM selector to inspect a specific component's React Fiber props/state (e.g. '#root', '.portfolio-table').
	- tab: Target tab index (-1 for active tab).
	"""
	t0 = time.perf_counter()
	try:
		page = await session.resolve_page(tab)
		js_script = """({ targetFramework, selector }) => {
			function safeSerialize(obj, maxDepth = 4, maxKeys = 80) {
				const seen = new WeakSet();
				function helper(val, depth) {
					if (val === null || typeof val !== 'object') {
						if (typeof val === 'function') return '[Function]';
						if (typeof val === 'symbol') return val.toString();
						return val;
					}
					if (val instanceof Element || val instanceof Node) {
						return `<${val.tagName ? val.tagName.toLowerCase() : 'Node'}${val.id ? '#' + val.id : ''}>`;
					}
					if (seen.has(val)) return '[Circular]';
					if (depth >= maxDepth) return Array.isArray(val) ? `[Array(${val.length})]` : '[Object]';
					seen.add(val);

					if (Array.isArray(val)) {
						const res = [];
						const len = Math.min(val.length, 60);
						for (let i = 0; i < len; i++) {
							res.push(helper(val[i], depth + 1));
						}
						if (val.length > len) res.push(`... ${val.length - len} more items`);
						return res;
					}

					const res = {};
					const keys = Object.keys(val).slice(0, maxKeys);
					for (const k of keys) {
						try {
							res[k] = helper(val[k], depth + 1);
						} catch (_) {
							res[k] = '[Unserializable]';
						}
					}
					return res;
				}
				return helper(obj, 0);
			}

			const results = [];
			const fw = (targetFramework || 'auto').toLowerCase();

			// 1. Next.js Hydration Data
			if ((fw === 'auto' || fw === 'next') && window.__NEXT_DATA__) {
				results.push({
					source: 'Next.js (__NEXT_DATA__)',
					keys: Object.keys(window.__NEXT_DATA__),
					data: safeSerialize(window.__NEXT_DATA__)
				});
			}

			// 2. Nuxt / SSR Initial State
			if ((fw === 'auto' || fw === 'vue') && window.__NUXT__) {
				results.push({
					source: 'Nuxt (__NUXT__)',
					keys: Object.keys(window.__NUXT__),
					data: safeSerialize(window.__NUXT__)
				});
			}
			if ((fw === 'auto') && window.__INITIAL_STATE__) {
				results.push({
					source: 'Window Initial State (__INITIAL_STATE__)',
					keys: Object.keys(window.__INITIAL_STATE__),
					data: safeSerialize(window.__INITIAL_STATE__)
				});
			}

			// 3. Global Redux Store
			if ((fw === 'auto' || fw === 'redux') && window.store && typeof window.store.getState === 'function') {
				const state = window.store.getState();
				results.push({
					source: 'Redux (window.store)',
					keys: Object.keys(state || {}),
					data: safeSerialize(state)
				});
			}

			// 4. Apollo GraphQL Cache
			if ((fw === 'auto' || fw === 'apollo') && window.__APOLLO_CLIENT__ && typeof window.__APOLLO_CLIENT__.extract === 'function') {
				const cache = window.__APOLLO_CLIENT__.extract();
				results.push({
					source: 'Apollo GraphQL Cache',
					keys: Object.keys(cache || {}),
					data: safeSerialize(cache)
				});
			}

			// 5. TanStack / React Query Client
			if ((fw === 'auto' || fw === 'query') && window.queryClient && typeof window.queryClient.getQueryCache === 'function') {
				const queries = window.queryClient.getQueryCache().getAll().map(q => ({
					queryKey: q.queryKey,
					status: q.state?.status,
					data: q.state?.data
				}));
				results.push({
					source: 'React Query (window.queryClient)',
					keys: queries.map(q => JSON.stringify(q.queryKey)),
					data: safeSerialize(queries)
				});
			}

			// 6. Vue Component Tree
			if (fw === 'auto' || fw === 'vue') {
				const vueEl = document.querySelector(selector || '#app, [data-v-app], #root');
				if (vueEl) {
					if (vueEl.__vue_app__) {
						const appState = vueEl.__vue_app__._instance?.data || vueEl.__vue_app__._context?.provides;
						if (appState) {
							results.push({
								source: 'Vue 3 (__vue_app__)',
								keys: Object.keys(appState),
								data: safeSerialize(appState)
							});
						}
					} else if (vueEl.__vue__) {
						results.push({
							source: 'Vue 2 (__vue__)',
							keys: Object.keys(vueEl.__vue__.$data || {}),
							data: safeSerialize(vueEl.__vue__.$data)
						});
					}
				}
			}

			// 7. React Fiber Traversal (Redux Provider or Component Props/State)
			if (fw === 'auto' || fw === 'react' || fw === 'redux') {
				const targetEl = selector ? document.querySelector(selector) : (document.querySelector('#root') || document.querySelector('#app') || document.body);
				if (targetEl) {
					const fiberKey = Object.keys(targetEl).find(k => k.startsWith('__reactFiber$') || k.startsWith('__reactInternalInstance$'));
					if (fiberKey) {
						let current = targetEl[fiberKey];
						let foundStore = false;

						// Walk up fiber tree to check for Redux context or QueryClient context
						let ancestor = current;
						let steps = 0;
						while (ancestor && steps < 50) {
							// Redux context check
							if (!foundStore && ancestor.memoizedProps?.store?.getState) {
								const state = ancestor.memoizedProps.store.getState();
								results.push({
									source: 'Redux Store (via React Fiber Context)',
									keys: Object.keys(state || {}),
									data: safeSerialize(state)
								});
								foundStore = true;
							}
							ancestor = ancestor.return;
							steps++;
						}

						// Specific component fiber props & state
						if (selector || (!results.length && targetEl !== document.body)) {
							results.push({
								source: `React Fiber Node (${targetEl.tagName.toLowerCase()}${targetEl.id ? '#' + targetEl.id : ''})`,
								keys: current.memoizedProps ? Object.keys(current.memoizedProps) : [],
								props: safeSerialize(current.memoizedProps),
								state: safeSerialize(current.memoizedState)
							});
						}
					}
				}
			}

			return results;
		}"""
		try:
			results = await asyncio.wait_for(
				page.evaluate(js_script, {
					"targetFramework": framework,
					"selector": selector,
				}),
				timeout=10.0,
			)
		except asyncio.TimeoutError:
			return f"Error detecting state: Timed out after 10000ms"
		elapsed_ms = int((time.perf_counter() - t0) * 1000)

		if not results:
			return (
				f"No in-memory state stores (Next.js, Redux, React Fiber, Vue, Apollo, React Query) detected "
				f"on {page.url} ({elapsed_ms}ms). The page may be server-rendered or state is privately scoped in closures."
			)

		lines = [f"In-Memory State Detective Results for {page.url} ({elapsed_ms}ms):", ""]
		for idx, item in enumerate(results):
			lines.append(f"### [{idx + 1}] Source: {item['source']}")
			if "keys" in item and item["keys"]:
				key_preview = ", ".join(f"`{k}`" for k in item["keys"][:20])
				if len(item["keys"]) > 20:
					key_preview += f" ... (+{len(item['keys']) - 20} more)"
				lines.append(f"- **Top-Level Keys ({len(item['keys'])} total)**: {key_preview}")

			dumped = json.dumps(item.get("data") or {"props": item.get("props"), "state": item.get("state")}, indent=2)
			if len(dumped) > 40000:
				dumped = dumped[:40000] + f"\n... [Truncated: {len(dumped)} total characters]"
			lines.append("```json")
			lines.append(dumped)
			lines.append("```\n")

		return "\n".join(lines)
	except Exception as exc:
		return f"Error detecting state: {exc}"


@mcp.tool()
async def evaluate_js(expression: str, tab: int = -1, timeout_ms: int = 15000) -> str:
	"""Evaluate a JavaScript expression in the active page or specified tab index and return the result."""
	try:
		page = await session.resolve_page(tab)
		result = await asyncio.wait_for(page.evaluate(expression), timeout=timeout_ms / 1000.0)
		return f"Result: {result}"
	except asyncio.TimeoutError:
		return f"JavaScript execution error: Timed out after {timeout_ms}ms"
	except Exception as exc:
		return f"JavaScript execution error: {exc}"


@mcp.tool()
async def switch_tab(index: int) -> str:
	"""Switch focus to an open tab by its numeric index (see status)."""
	try:
		pages = await session.get_pages()
		if index < 0 or index >= len(pages):
			return f"Invalid tab index {index}. Total open tabs: {len(pages)}"

		page = pages[index]
		session.set_active_page(page)
		await page.bring_to_front()
		title = await page.title()
		return f"Switched to tab [{index}]: '{title}' ({page.url})"
	except Exception as exc:
		return f"Error switching tab: {exc}"


@mcp.tool()
async def close_tab(index: int = -1) -> str:
	"""Close a tab by index (-1 closes active tab, -99 or closing last tab terminates the browser window)."""
	try:
		if index == -99:
			return await close_browser()

		pages = await session.get_pages()
		if not pages:
			return await close_browser()

		if index == -1:
			if session._active_page is not None and not session._active_page.is_closed():
				page = session._active_page
			else:
				page = pages[-1]
			target_index = pages.index(page) if page in pages else -1
		else:
			if index < 0 or index >= len(pages):
				return f"Invalid tab index {index}. Total open tabs: {len(pages)}"
			page = pages[index]
			target_index = index

		url = page.url
		await keep_alive_mgr.stop(page)
		await page.close()

		remaining = await session.get_pages()
		if page == session._active_page:
			session._active_page = remaining[-1] if remaining else None
		if not remaining:
			await close_browser()
			return f"Closed last tab [{target_index}] ({url}). Browser window completely closed."
		return f"Closed tab [{target_index}] ({url}). Remaining open tabs: {len(remaining)}"
	except Exception as exc:
		return f"Error closing tab: {exc}"


def _force_kill_browser_processes():
	"""Terminates lingering Chromium processes strictly associated with the agent's profile or CDP port."""
	try:
		subprocess.run(["pkill", "-f", "--", f"--user-data-dir={PROFILE_DIR}"], capture_output=True)
		subprocess.run(["pkill", "-f", "--", f"--remote-debugging-port={CDP_PORT}"], capture_output=True)
		time.sleep(0.3)
		subprocess.run(["pkill", "-9", "-f", "--", f"--user-data-dir={PROFILE_DIR}"], capture_output=True)
		subprocess.run(["pkill", "-9", "-f", "--", f"--remote-debugging-port={CDP_PORT}"], capture_output=True)
		# Clean up any orphaned Chromium singleton locks left behind
		for lock_name in ("SingletonLock", "SingletonSocket", "SingletonCookie"):
			lock_path = os.path.join(PROFILE_DIR, lock_name)
			if os.path.islink(lock_path) or os.path.exists(lock_path):
				try:
					os.unlink(lock_path)
				except Exception:
					pass
	except Exception:
		pass


@mcp.tool()
async def close_browser(force_kill: bool = True) -> str:
	"""Completely close the browser window, terminate all browser and renderer processes, and release all resources."""
	try:
		if session._context is not None:
			try:
				await session._context.close()
			except Exception:
				pass
		if session._browser is not None:
			try:
				await session._browser.close()
			except Exception:
				pass
		await session.close()
		if force_kill:
			_force_kill_browser_processes()
		return "Browser completely closed and all resources released."
	except Exception as exc:
		return f"Error closing browser: {exc}"


@mcp.tool()
async def restart_browser() -> str:
	"""Force terminate all browser instances, clean up lingering renderer processes, and start a fresh session."""
	try:
		await close_browser(force_kill=True)
		# Allow OS kernel and filesystem locks on PROFILE_DIR to settle cleanly
		await asyncio.sleep(0.3)
		page = await session.get_active_page()
		title = await page.title()
		return f"Browser restarted successfully with fresh session on tab [0]: '{title}' ({page.url})"
	except Exception as exc:
		return f"Error restarting browser: {exc}"


def main():
	parser = argparse.ArgumentParser(
		prog="stealth-browser",
		description="FastMCP server providing browser automation tools over CDP or standalone stealth Chromium using patchright."
	)
	parser.parse_args()

	def _handle_signal(signum, _frame):
		raise SystemExit(0)

	for sig in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
		signal.signal(sig, _handle_signal)

	try:
		mcp.run()
	except (KeyboardInterrupt, SystemExit):
		pass
	finally:
		session.close_sync()
		os._exit(0)


if __name__ == "__main__":
	main()
