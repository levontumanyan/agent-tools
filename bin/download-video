#!/usr/bin/env -S uv run --script
# /// script
# dependencies = [
# 	"pyobjc-core",
# 	"pyobjc-framework-Vision",
# 	"pyobjc-framework-Cocoa",
# 	"gnureadline",
# ]
# ///
"""Download videos with rich metadata to Google Drive. Instagram → H.264/AAC MP4 (WhatsApp-native). Others → AV1/VP9 MKV."""

import sys
import os
import subprocess
import argparse
import re
import tempfile
import glob


def get_default_media_dir():
	"""Resolves the active Google Drive memes directory on macOS."""
	cloud_storage = glob.glob(os.path.expanduser("~/Library/CloudStorage/GoogleDrive-*/My Drive/media/memes"))
	if cloud_storage and os.path.isdir(cloud_storage[0]):
		return cloud_storage[0]
	legacy_path = os.path.expanduser("~/Google Drive/My Drive/media/memes")
	if os.path.isdir(legacy_path):
		return legacy_path
	gdrive_roots = glob.glob(os.path.expanduser("~/Library/CloudStorage/GoogleDrive-*/My Drive"))
	if gdrive_roots and os.path.isdir(gdrive_roots[0]):
		return os.path.join(gdrive_roots[0], "media", "memes")
	return legacy_path


DEFAULT_DIR = get_default_media_dir()

def get_clipboard_url():
	try:
		result = subprocess.run(["pbpaste"], capture_output=True, text=True, check=True)
		content = result.stdout.strip()
		if re.match(r'^https?://[^\s/$.?#].[^\s]*$', content):
			return content
	except Exception:
		pass
	return None

def is_instagram_url(url):
	return bool(re.search(r'instagram\.com/(p|reel|stories)/', url))

def is_youtube_url(url):
	return bool(re.search(r'(?:youtube\.com/(?:watch\?v=|shorts/|embed/|live/)|youtu\.be/)', url))

def ffmpeg(*args):
	return subprocess.run(["ffmpeg", *args], capture_output=True)

def embed_note(filepath, note):
	base, ext = os.path.splitext(filepath)
	tmp = base + ".notetmp" + ext
	args = ["-i", filepath, "-c", "copy"]
	if ext.lower() == ".mp4":
		args += ["-movflags", "+faststart+use_metadata_tags"]
	args += ["-metadata", f"NOTE={note}", tmp, "-y"]
	r = ffmpeg(*args)
	if r.returncode == 0:
		os.replace(tmp, filepath)
		print(f"\033[1;32m[download-video] Note embedded →\033[0m {os.path.basename(filepath)}")
	else:
		if os.path.exists(tmp):
			os.remove(tmp)
		print("\033[1;33m[download-video] Warning: could not embed note.\033[0m", file=sys.stderr)

def transcode_to_h264(src, dst, note=None):
	"""Re-encodes to H.264/AAC MP4 for WhatsApp-native playback.

	WhatsApp uses the first frame as thumbnail and ignores cover art. To avoid a
	black thumbnail (common on Instagram reels), we prepend a 1-frame clip from
	t=0.5s before the main video.
	"""
	print("\033[1;34m[download-video]\033[0m Transcoding to H.264/AAC...")
	args = [
		"-i", src,
		"-i", src,
		"-filter_complex",
		"[0:v]trim=start=0.5:end=0.54,setpts=PTS-STARTPTS[thumbv]; "
		"[0:a]atrim=start=0.5:end=0.54,asetpts=PTS-STARTPTS[thumba]; "
		"[thumbv][thumba][1:v][1:a]concat=n=2:v=1:a=1[outv][outa]",
		"-map", "[outv]",
		"-map", "[outa]",
		"-c:v", "libx264", "-preset", "fast", "-crf", "23", "-pix_fmt", "yuv420p",
		"-c:a", "aac", "-b:a", "128k",
		"-movflags", "+faststart+use_metadata_tags"
	]
	if note:
		args += ["-metadata", f"NOTE={note}"]
	args += [dst, "-y"]

	try:
		if ffmpeg(*args).returncode != 0:
			raise RuntimeError("transcode failed")
		os.remove(src)
		print(f"\033[1;32m[download-video] Transcoded →\033[0m {os.path.basename(dst)}")
		return True
	except RuntimeError as e:
		print(f"\033[1;31m[download-video] Transcode failed ({e}).\033[0m", file=sys.stderr)
		return False

def get_video_duration(filepath):
	cmd = [
		"ffprobe", "-v", "error", "-show_entries", "format=duration",
		"-of", "default=noprint_wrappers=1:nokey=1", filepath
	]
	try:
		res = subprocess.run(cmd, capture_output=True, text=True, check=True)
		return float(res.stdout.strip())
	except Exception:
		return None

def extract_frames(video_path, num_frames=5):
	duration = get_video_duration(video_path)
	if not duration or duration <= 0:
		timestamps = [1.0, 3.0, 5.0, 8.0, 12.0]
	else:
		start = min(1.0, duration * 0.1)
		end = duration * 0.9
		if end <= start:
			timestamps = [duration / 2.0]
		else:
			step = (end - start) / (num_frames - 1) if num_frames > 1 else 0
			timestamps = [start + i * step for i in range(num_frames)]

	temp_files = []
	for i, ts in enumerate(timestamps):
		tmp_fd, tmp_fp = tempfile.mkstemp(suffix=f"_frame_{i}.jpg")
		os.close(tmp_fd)
		cmd = [
			"ffmpeg", "-y", "-ss", str(ts), "-i", video_path,
			"-vframes", "1", "-q:v", "2", tmp_fp
		]
		res = subprocess.run(cmd, capture_output=True)
		if res.returncode == 0 and os.path.exists(tmp_fp) and os.path.getsize(tmp_fp) > 0:
			temp_files.append(tmp_fp)
		else:
			if os.path.exists(tmp_fp):
				os.remove(tmp_fp)
	return temp_files

def run_ocr_and_classify_on_video(video_path):
	try:
		import Vision
		from Foundation import NSURL
	except ImportError:
		print("\033[1;33m[download-video] Warning: pyobjc-framework-Vision not available. Skipping OCR and Classification.\033[0m")
		return [], []

	frames = extract_frames(video_path)
	all_texts = []
	all_tags = {}

	ignored_tags = {
		"root", "animal", "mammal", "vertebrate", "organism", "living_thing",
		"fabric", "material", "structure", "matter", "object", "clothing",
		"person", "people", "adult", "feline", "carnivore"
	}

	for frame in frames:
		url = NSURL.fileURLWithPath_(frame)

		ocr_results = []
		def ocr_handler(request, error):
			if error:
				return
			obs = request.results()
			if obs:
				for o in obs:
					candidates = o.topCandidates_(1)
					if candidates:
						ocr_results.append(candidates[0].string())

		ocr_req = Vision.VNRecognizeTextRequest.alloc().initWithCompletionHandler_(ocr_handler)
		ocr_req.setRecognitionLevel_(Vision.VNRequestTextRecognitionLevelAccurate)

		class_results = []
		def class_handler(request, error):
			if error:
				return
			obs = request.results()
			if obs:
				for o in obs:
					if o.confidence() > 0.5:
						class_results.append((o.identifier(), o.confidence()))

		class_req = Vision.VNClassifyImageRequest.alloc().initWithCompletionHandler_(class_handler)

		handler = Vision.VNImageRequestHandler.alloc().initWithURL_options_(url, None)
		success, error = handler.performRequests_error_([ocr_req, class_req], None)
		if success:
			all_texts.extend(ocr_results)
			for tag, conf in class_results:
				tag_clean = tag.strip().lower()
				if tag_clean not in ignored_tags:
					all_tags[tag_clean] = max(all_tags.get(tag_clean, 0), conf)
		os.remove(frame)

	seen = set()
	unique_texts = []
	for t in all_texts:
		t_clean = t.strip()
		if t_clean and t_clean.lower() not in seen:
			seen.add(t_clean.lower())
			unique_texts.append(t_clean)

	sorted_tags = sorted(all_tags.items(), key=lambda x: x[1], reverse=True)
	hashtags = []
	for tag, _ in sorted_tags[:5]:
		hashtag = "#" + re.sub(r'[\s_]+', '', tag)
		hashtags.append(hashtag)

	return unique_texts, hashtags

def make_filename_slug(ocr_texts):
	if not ocr_texts:
		return ""
	combined = " ".join(ocr_texts[:2])
	slug = re.sub(r'[^a-zA-Z0-9\s-]', '', combined)
	slug = re.sub(r'[\s_]+', '-', slug)
	slug = re.sub(r'-+', '-', slug)
	slug = slug.strip('-').lower()

	max_len = 50
	if len(slug) > max_len:
		truncated = slug[:max_len]
		last_dash = truncated.rfind('-')
		if last_dash > max_len // 2:
			slug = truncated[:last_dash]
		else:
			slug = truncated
	return slug.strip('-')

def is_non_interactive():
	return (
		not sys.stdin.isatty()
		or os.environ.get("ANTIGRAVITY_AGENT") == "1"
		or os.environ.get("TERM") == "dumb"
		or os.environ.get("NONINTERACTIVE") == "1"
	)

def input_with_default(prompt, default_val=None):
	if is_non_interactive():
		return default_val or ""
	if default_val:
		replacements = {
			"«": '"', "»": '"',
			"“": '"', "”": '"',
			"‘": "'", "’": "'",
			"—": "-", "–": "-"
		}
		for k, v in replacements.items():
			default_val = default_val.replace(k, v)
		safe_val = default_val.encode("ascii", errors="ignore").decode("ascii")

		import gnureadline as readline
		readline.set_startup_hook(lambda: readline.insert_text(safe_val))
	try:
		return input(prompt).strip()
	except EOFError:
		return ""
	finally:
		if default_val:
			import gnureadline as readline
			readline.set_startup_hook()

def delete_file_and_archive_entry(target_name, output_dir, archive_file):
	pattern1 = os.path.join(output_dir, f"*{target_name}*")
	matched_files = glob.glob(pattern1)

	if not matched_files:
		alt_name = target_name.replace("_", "-")
		if alt_name != target_name:
			matched_files = glob.glob(os.path.join(output_dir, f"*{alt_name}*"))

	matched_files = [f for f in matched_files if os.path.isfile(f) and os.path.basename(f) not in (".yt-dlp-archive", ".DS_Store")]

	if not matched_files:
		print(f"\033[1;31m[download-video] No files found matching: {target_name}\033[0m")
		return False

	for fp in matched_files:
		post_id = None
		cmd = [
			"ffprobe", "-v", "error", "-show_entries", "format_tags=comment,purl",
			"-of", "default=noprint_wrappers=1:nokey=1", fp
		]
		res = subprocess.run(cmd, capture_output=True, text=True)
		if res.returncode == 0 and res.stdout.strip():
			urls = res.stdout.strip().split('\n')
			for u in urls:
				m = re.search(r'/(?:p|reel)/([A-Za-z0-9_-]+)', u)
				if m:
					post_id = m.group(1)
					break

		if post_id:
			print(f"\033[1;34m[download-video]\033[0m Found post ID: {post_id} in {os.path.basename(fp)}")
			if os.path.exists(archive_file):
				try:
					with open(archive_file, "r") as f:
						lines = f.readlines()

					new_lines = []
					removed = False
					for line in lines:
						if post_id in line:
							removed = True
						else:
							new_lines.append(line)

					if removed:
						with open(archive_file, "w") as f:
							f.writelines(new_lines)
						print(f"\033[1;32m[download-video] Removed post ID from archive.\033[0m")
				except Exception as e:
					print(f"\033[1;33m[download-video] Warning: could not edit archive: {e}\033[0m")
		else:
			print(f"\033[1;33m[download-video] Warning: No Instagram post ID found in metadata for {os.path.basename(fp)}\033[0m")

		try:
			os.remove(fp)
			print(f"\033[1;32m[download-video] Deleted file:\033[0m {os.path.basename(fp)}")
		except Exception as e:
			print(f"\033[1;31m[download-video] Error deleting file {fp}: {e}\033[0m")

	return True

def show_video_metadata(target_name, output_dir):
	import json
	pattern1 = os.path.join(output_dir, f"*{target_name}*")
	matched_files = glob.glob(pattern1)

	if not matched_files:
		alt_name = target_name.replace("_", "-")
		if alt_name != target_name:
			matched_files = glob.glob(os.path.join(output_dir, f"*{alt_name}*"))

	matched_files = [f for f in matched_files if os.path.isfile(f) and os.path.basename(f) not in (".yt-dlp-archive", ".DS_Store")]

	if not matched_files:
		print(f"\033[1;31m[download-video] No files found matching: {target_name}\033[0m")
		return False

	for fp in matched_files:
		print(f"\n\033[1;34m=== Metadata for {os.path.basename(fp)} ===\033[0m")
		cmd = ["ffprobe", "-v", "quiet", "-show_format", "-show_streams", "-print_format", "json", fp]
		res = subprocess.run(cmd, capture_output=True, text=True)
		if res.returncode == 0:
			try:
				data = json.loads(res.stdout)
				print(json.dumps(data, indent=2))
			except Exception:
				print(res.stdout)
		else:
			print(f"\033[1;31mError running ffprobe for {fp}\033[0m")
	return True

def main():
	parser = argparse.ArgumentParser(
		description="Download videos with rich metadata. Instagram → H.264/AAC MP4 (WhatsApp-native). Others → AV1/VP9 MKV."
	)
	parser.add_argument("urls", nargs="*", help="URLs to download. Omit to use clipboard or prompt.")
	parser.add_argument("-o", "--output-dir", default=DEFAULT_DIR, help=f"Output directory (default: {DEFAULT_DIR}).")
	parser.add_argument("-n", "--name", default=None, help="Custom filename stem (no extension).")
	parser.add_argument("--note", default=None, help="Personal NOTE metadata (non-interactive).")
	parser.add_argument("-a", "--audio-only", action="store_true", help="Download audio only (MP3).")
	parser.add_argument("-d", "--delete", default=None, help="Delete a video file by name and remove it from the yt-dlp archive.")
	parser.add_argument("-m", "--metadata", default=None, help="Show all container and stream metadata for a video file.")
	parser.add_argument("-c", "--cookies", default=None, help="Path to cookies file passed to yt-dlp.")
	parser.add_argument("--cookies-from-browser", default=None, help="Browser to extract cookies from (e.g. chrome, safari, firefox).")
	parser.add_argument("-s", "--section", "--snippet", dest="section", default=None, help="Download only a section/snippet (YouTube only). E.g. '01:30-02:15' or '90-135'.")
	args = parser.parse_args()

	output_dir = os.path.abspath(os.path.expanduser(args.output_dir))
	os.makedirs(output_dir, exist_ok=True)

	archive_file = os.path.join(output_dir, ".yt-dlp-archive")
	if args.delete:
		success = delete_file_and_archive_entry(args.delete, output_dir, archive_file)
		sys.exit(0 if success else 1)

	if args.metadata:
		success = show_video_metadata(args.metadata, output_dir)
		sys.exit(0 if success else 1)

	urls = args.urls
	if not urls:
		clipboard_url = get_clipboard_url()
		if clipboard_url:
			print(f"\033[1;32mFound URL in clipboard:\033[0m {clipboard_url}")
			urls = [clipboard_url]
		else:
			try:
				url_input = input("Enter video URL to download: ").strip()
				urls = [url_input] if url_input else []
			except (KeyboardInterrupt, EOFError):
				pass
		if not urls:
			print("\033[1;31mNo URL provided. Exiting.\033[0m")
			sys.exit(0)

	if args.section:
		for u in urls:
			if not is_youtube_url(u):
				print(f"\033[1;31m[download-video] Error: The --section flag is only supported for YouTube videos. Invalid URL: {u}\033[0m", file=sys.stderr)
				sys.exit(1)

	if any((is_instagram_url(u) or is_youtube_url(u)) for u in urls) and not args.cookies and not args.cookies_from_browser:
		args.cookies_from_browser = "brave"

	archive_file = os.path.join(output_dir, ".yt-dlp-archive")
	success_count = 0

	for url in urls:
		instagram = is_instagram_url(url)
		insta_id = None
		if instagram:
			m = re.search(r'/(?:p|reel|stories)/([A-Za-z0-9_-]+)', url)
			if m:
				insta_id = m.group(1)

		if insta_id and os.path.exists(archive_file):
			try:
				with open(archive_file, "r") as f:
					archive_content = f.read()
				if f"instagram {insta_id}" in archive_content:
					print(f"\033[1;33m[download-video] {insta_id} has already been recorded in the archive. Skipping.\033[0m")
					continue
			except Exception:
				pass

		if instagram:
			print(f"\n\033[1;35m[download-video]\033[0m Instagram → H.264/AAC MP4 | Downloading {url}...")
		else:
			print(f"\n\033[1;34m[download-video]\033[0m Downloading {url}...")

		files_before = set(os.listdir(output_dir))

		cmd = ["yt-dlp"]
		if args.audio_only:
			cmd += ["-x", "--audio-format", "mp3", "--audio-quality", "0"]
		elif instagram:
			cmd += ["-f", "bestvideo[vcodec^=vp09]+bestaudio/bestvideo+bestaudio/best", "--merge-output-format", "mkv"]
		else:
			cmd += ["-f", "bv*[vcodec^=av01]+ba/bv*[vcodec^=vp9]+ba/bv*+ba/best", "--merge-output-format", "mkv"]
		cmd += ["--embed-metadata", "--embed-thumbnail", "--restrict-filenames", "--ignore-errors"]
		if args.section:
			sec = args.section.strip()
			if not sec.startswith("*"):
				sec = f"*{sec}"
			cmd += ["--download-sections", sec, "--force-keyframes-at-cuts"]
		if not instagram and not args.section:
			cmd += ["--download-archive", archive_file]

		if args.cookies:
			cmd += ["--cookies", args.cookies]
		elif args.cookies_from_browser:
			cmd += ["--cookies-from-browser", args.cookies_from_browser]

		if args.name:
			stem = (args.name + ".instatmp") if not args.audio_only else args.name
		else:
			stem = "%(title)s.instatmp" if not args.audio_only else "%(title)s"
		cmd += ["-o", os.path.join(output_dir, f"{stem}.%(ext)s"), url]

		try:
			res = subprocess.run(cmd)

			got_files = False
			new_files = set(os.listdir(output_dir)) - files_before
			dl_file = next((os.path.join(output_dir, f) for f in new_files if f.endswith((".mkv", ".mp4", ".mp3", ".webm", ".m4a"))), None)
			if dl_file and os.path.exists(dl_file):
				got_files = True

			if res.returncode != 0 and not got_files:
				raise subprocess.CalledProcessError(res.returncode, cmd)

			ocr_texts = []
			hashtags = []
			if got_files and dl_file and not args.audio_only and dl_file.lower().endswith((".mp4", ".mkv", ".webm")):
				if args.note is None or not args.name:
					print("\033[1;34m[download-video]\033[0m Running Apple Vision OCR and image classification on video frames...")
					ocr_texts, hashtags = run_ocr_and_classify_on_video(dl_file)

			personal_note = ""
			if args.note is not None:
				personal_note = args.note
			else:
				suggested_note = ", ".join(ocr_texts) if ocr_texts else ""
				if hashtags:
					tag_str = " ".join(hashtags)
					if suggested_note:
						suggested_note += " " + tag_str
					else:
						suggested_note = tag_str
				personal_note = input_with_default(
					"Personal note (Enter to accept/skip, or edit directly): ",
					suggested_note
				)

			custom_name = ""
			if args.name:
				custom_name = args.name
			else:
				suggested_name = make_filename_slug(ocr_texts)
				custom_name = input_with_default(
					"Custom filename (Enter to accept, or edit directly, or empty to use platform title): ",
					suggested_name
				)

			if not args.audio_only:
				if dl_file and os.path.exists(dl_file):
					if custom_name:
						clean_custom_name = custom_name.replace("_", "-")
						tmp_mkv = os.path.join(output_dir, f"{clean_custom_name}.instatmp.mkv")
						if dl_file != tmp_mkv:
							os.rename(dl_file, tmp_mkv)
					else:
						tmp_mkv = dl_file

					final_mp4 = os.path.splitext(tmp_mkv)[0].removesuffix(".instatmp") + ".mp4"
					ok = transcode_to_h264(tmp_mkv, final_mp4, personal_note)
					if not ok and personal_note:
						embed_note(tmp_mkv, personal_note)
			else:
				if dl_file and os.path.exists(dl_file):
					ext = os.path.splitext(dl_file)[1]
					target_fp = dl_file
					if custom_name:
						clean_custom = custom_name.replace("_", "-")
						target_fp = os.path.join(output_dir, f"{clean_custom}{ext}")
						os.rename(dl_file, target_fp)

					if personal_note:
						embed_note(target_fp, personal_note)

			new_files_after = set(os.listdir(output_dir)) - files_before
			for f in new_files_after:
				if "_" in f and f not in (".DS_Store", ".yt-dlp-archive"):
					old_fp = os.path.join(output_dir, f)
					new_fp = os.path.join(output_dir, f.replace("_", "-"))
					if os.path.exists(old_fp):
						os.rename(old_fp, new_fp)

			if insta_id:
				try:
					with open(archive_file, "a") as f:
						f.write(f"instagram {insta_id}\n")
				except Exception:
					pass
			success_count += 1

		except subprocess.CalledProcessError:
			gallery_success = False
			if instagram:
				print("\033[1;33m[download-video] yt-dlp failed (likely a photo/carousel post). Retrying with gallery-dl...\033[0m")
				import shutil
				gallery_bin = shutil.which("gallery-dl") or shutil.which("gallery-dl", path="/opt/homebrew/bin:/usr/local/bin") or "gallery-dl"
				gallery_cmd = [gallery_bin, "-D", output_dir]
				if args.cookies:
					gallery_cmd += ["--cookies", args.cookies]
				elif args.cookies_from_browser:
					gallery_cmd += ["--cookies-from-browser", args.cookies_from_browser]

				if args.name:
					stem = args.name.replace('_', '-')
					gallery_cmd += ["--filename", f"{stem}-{{num}}.{{extension}}"]

				gallery_cmd.append(url)

				try:
					r = subprocess.run(gallery_cmd, check=True)
					if r.returncode == 0:
						gallery_success = True
				except Exception as ge:
					print(f"\033[1;31m[download-video] gallery-dl also failed: {ge}\033[0m", file=sys.stderr)

			if gallery_success:
				new_files_after = set(os.listdir(output_dir)) - files_before
				for f in new_files_after:
					if "_" in f and f not in (".DS_Store", ".yt-dlp-archive"):
						old_fp = os.path.join(output_dir, f)
						new_fp = os.path.join(output_dir, f.replace("_", "-"))
						if os.path.exists(old_fp):
							os.rename(old_fp, new_fp)
				if insta_id:
					try:
						with open(archive_file, "a") as f:
							f.write(f"instagram {insta_id}\n")
					except Exception:
						pass
				success_count += 1
			else:
				print(f"\033[1;31m[download-video] Failed to download:\033[0m {url}", file=sys.stderr)
		except KeyboardInterrupt:
			print("\n\033[1;33m[download-video] Interrupted.\033[0m")
			new_files_left = set(os.listdir(output_dir)) - files_before
			for f in new_files_left:
				if f not in (".DS_Store", ".yt-dlp-archive"):
					try:
						os.remove(os.path.join(output_dir, f))
					except Exception:
						pass
			break

	if success_count > 0:
		print(f"\n\033[1;32m[download-video] Downloaded {success_count} file(s) to:\033[0m {output_dir}\n")

if __name__ == "__main__":
	main()
